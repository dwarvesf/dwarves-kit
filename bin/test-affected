#!/usr/bin/env bash
# bin/test-affected -- run only the tests a change touches, and skip the ones already green.
#
# Standalone maintainer tool (like bin/activate, bin/release): not a forwarder.
# Overlaps tests/run-all.sh --changed on purpose-narrow ground: that one picks by a code-line
# basename match and has no cache; this one picks by path OR basename anywhere in a suite,
# records a PASS per content key, and can explain each pick (--list).
#
# Usage: test-affected [--base <ref>] [--list] [--no-cache]
#   --base <ref>  diff base (default: origin/<default branch>, resolved like `wrap`)
#   --list        print the selection and the reason for each (self | references <path> |
#                 module <mod> | reads <path>), plus UNCOVERED files; run nothing
#   --no-cache    ignore recorded PASSes (a PASS is still recorded)
# Selection: a changed tests/test-*.sh -> itself; any other changed file -> every
# tests/test-*.sh naming its repo-relative path. A non-source file (docs, fixtures) matches
# only a full-path reference, never inside a longer path or a comment; a source (lib/, hooks/,
# bin/, commands/, skills/, agents/) also matches by basename when that is over 5 chars. A path
# the test-meta area suites read by glob or scan (meta_input) picks the area suites that read it
# (meta_areas), else the tests/test-meta.sh runner. A changed file no test names is UNCOVERED
# (reported, not a failure).
# Cache: key = sha256(test + every source file it names + VERSION), under
# <kit log dir>/test-cache/. Only PASS is recorded. An unusable cache dir means run all.
# Timeout: a suite runs under TEST_AFFECTED_TIMEOUT_SECS when set, else its line in
# bin/test-affected.timeouts (`<suite> <seconds>`, 2 x measured p95, floor 60), else 300. A suite
# killed at its limit prints `TIMEOUT <suite> (limit Ns)`, never FAIL.
# Exit: 0 all green, 1 any FAIL or TIMEOUT, 2 usage or no base.
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die() { echo "test-affected: $*" >&2; exit 2; }

BASE="" LIST=0 NOCACHE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --base) [ $# -ge 2 ] || die "--base needs a ref"; BASE="$2"; shift 2 ;;
    --list) LIST=1; shift ;;
    --no-cache) NOCACHE=1; shift ;;
    -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d;s/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument: $1 (see --help)" ;;
  esac
done

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repo"
cd "$ROOT"

# Same resolution as lib/wrap/wrap.sh _default_branch: origin/HEAD if live, else main, else master.
default_branch() {
  local ref name
  ref="$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -n "$ref" ]; then
    name="${ref#refs/remotes/origin/}"
    if [ "$name" != "$ref" ] && git show-ref --verify --quiet "refs/remotes/origin/$name"; then
      printf '%s\n' "$name"; return 0
    fi
  fi
  for name in main master; do
    if git show-ref --verify --quiet "refs/remotes/origin/$name"; then printf '%s\n' "$name"; return 0; fi
  done
  return 1
}
if [ -z "$BASE" ]; then
  name="$(default_branch)" || die "no default branch resolved (origin/HEAD, origin/main, origin/master all absent); pass --base"
  BASE="origin/$name"
fi
git rev-parse --verify --quiet "$BASE^{commit}" >/dev/null || die "base ref not found: $BASE"

TMP="$(mktemp -d "${TMPDIR:-/tmp}/test-affected.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

sha() { if command -v shasum >/dev/null 2>&1; then shasum -a 256; else sha256sum; fi | cut -c1-64; }

# --- changed files: committed since the base, staged/unstaged, and untracked ---
{
  git -c core.quotepath=off diff --name-only "$BASE...HEAD" 2>/dev/null || true
  git -c core.quotepath=off diff --name-only HEAD 2>/dev/null || true
  git -c core.quotepath=off ls-files --others --exclude-standard
} | grep -v '^$' | sort -u >"$TMP/changed" || true

# --- source universe (for the cache key) and its token map: path and basename -> path ---
git -c core.quotepath=off ls-files -co --exclude-standard -- 'lib/*.sh' 'tests/lib/*.sh' 'hooks/*' 'bin/*' 'commands/*.md' 'skills/*.md' 'agents/*.md' \
  | grep -v '/tests/' | sort -u | while IFS= read -r s; do [ -f "$s" ] && printf '%s\n' "$s"; done >"$TMP/sources" || true
# Basenames of 5 chars or fewer (`board`, `lint`) match half the suite; only the path counts.
while IFS= read -r s; do
  b="$(basename "$s")"
  printf '%s\t%s\n' "$s" "$s"
  [ "${#b}" -gt 5 ] && printf '%s\t%s\n' "$b" "$s"
done <"$TMP/sources" >"$TMP/map" || true
cut -f1 "$TMP/map" | sort -u >"$TMP/pats"

is_source() { case "$1" in lib/*.sh|tests/lib/*.sh|hooks/*|bin/*|commands/*.md|skills/*.md|agents/*.md) return 0 ;; *) return 1 ;; esac; }

# Suites that name a NON-source path as a path: not a comment line, not part of a longer path
# (docs/README.md is not README.md), and not a longer name. `$KIT_DIR/README.md` counts.
refs_exact() {
  perl -e 'my $p = shift;
FILE: for my $f (@ARGV) {
  open(my $h, "<", $f) or next;
  while (<$h>) {
    next if /^\s*#/;
    my $pos = 0;
    while ((my $i = index($_, $p, $pos)) >= 0) {
      my $end = $i + length($p); $pos = $end;
      next if substr($_, $end, 1) =~ /[\w-]/;
      my $pre = substr($_, 0, $i);
      next if $pre =~ m{[\w.\-]$};
      next if $pre =~ m{/$} && $pre !~ m{(?:\$\{?\w+\}?|\$\(.*\)|")/$};
      print "$f\n"; next FILE;
    }
  }
}' "$@"
}

# Suites naming a SOURCE by path, or by a basename over 5 chars, on a non-comment line.
refs_any() {
  perl -e 'my @p = split /\n/, shift;
FILE: for my $f (@ARGV) {
  open(my $h, "<", $f) or next;
  while (<$h>) { next if /^\s*#/; for my $q (@p) { if (index($_, $q) >= 0) { print "$f\n"; next FILE } } }
}' "$@"
}

# --- test-meta: the area suites ---------------------------------------------------------------
# tests/test-meta.sh is a runner over eight area suites (tests/test-meta-<area>.sh), the heaviest
# group (~145s for docs-registry alone), so a diff picks only the areas that read a changed path,
# not the group. The nightly --all runs every area daily, so no input loses coverage overall.
#
# Two attribution paths, both deterministic:
#   1. A suite that NAMES the path (the reference scan above) is picked like any other suite, so
#      `commands/assign.md` or `lib/gate/proof-gate.sh` reach the areas that cite them.
#   2. meta_areas below lists what the areas read by GLOB or SCAN, which no reference scan sees:
#      the file loops, the git ls-files scans, the installer run, the registry inputs.
# A meta input that neither path attributes picks the tests/test-meta.sh runner (run-all.sh
# expands it to every area), never nothing. A path every area scan excludes picks no area.
#
# No area suite is always-run. The registry freshness pin lives in docs-registry and is mapped by
# its inputs; hooks/ship-gate.sh already refuses a push that moves one without a fresh
# docs/FEATURES.md. The tree-wide lints that guard every diff carry their own `# always:` header,
# which run-all.sh --changed adds.
#
# What each area reads by glob or scan (derived from the suites' own paths):
#   plugin-hooks     .claude-plugin/ VERSION tool.toml (three version surfaces, manifests), settings.json
#                    hooks/* install.sh (executability, hooks.json parity, the install runs), every live
#                    *.md (the /user: scan), the libs gate-ledger.sh sources (the installed run)
#   contract         install.sh (settings merge run), examples/hello-spec/AGENTS.md
#   agents-commands  agents/*.md commands/*.md skills/*/*.md (file loops, bare-agent-name scan)
#   review-verifiers agents/ commands/ skills/ (frontmatter loops, generated-by scan)
#   vmodel-dispatch  commands/*.md agents/*.md skills/*/SKILL.md hooks/*.sh (file counts against the
#                    README tables), live docs (stale-phase scan over docs/
#                    commands/ and the root docs), the libs gate-ledger.sh sources
#   goal-ledger      the libs gate-ledger.sh sources (it runs gate-ledger.sh)
#   spec-depth       nothing by glob; every path it reads is named, so the reference scan covers it
#   docs-registry    hooks/ commands/ agents/ skills/ lib kit-verb files and lib/*/tests/ (registry
#                    inputs), docs/specs docs/decisions (collision guard, Specs column), docs/FEATURES.md
#                    (freshness pin; also a live doc for the two scans above), examples/ .github/workflows/ (demo project, workflow pins), settings.json
# Excluded by every scan (the dated archives): docs/{verification,retro,handoff,research}/,
# docs/CHANGELOG.md, CHANGELOG.md, _meta/. A named path there still picks by reference.
META_ALL="plugin-hooks contract agents-commands spec-depth review-verifiers vmodel-dispatch goal-ledger docs-registry"

# A lib file that declares a kit-verb feeds the registry; so does one that just dropped the header,
# so the base copy counts too.
kit_verb_file() {
  [ "$(head -40 "$1" 2>/dev/null | grep -c '^# kit-verb: ')" != 0 ] \
    || [ "$(git show "$BASE:$1" 2>/dev/null | head -40 | grep -c '^# kit-verb: ')" != 0 ]
}

meta_input() {
  case "$1" in
    *.md|commands/*|agents/*|skills/*|hooks/*|install.sh|settings.json|VERSION|tool.toml) return 0 ;;
    .claude-plugin/*|.github/workflows/*|examples/*|bin/learn|bin/precedent) return 0 ;;
    lib/board/*|lib/classify/*|lib/config/*|lib/gate/*|lib/goal/*|lib/ledger/*) return 0 ;;
    lib/registry/*|lib/spec/*|lib/telemetry/*|lib/*/tests/*) return 0 ;;
    tests/fixtures/gates-on*|tests/test-hooks.sh|tests/test-e2e.sh) return 0 ;;
    lib/*) kit_verb_file "$1" ;;
    *) return 1 ;;
  esac
}

# Area names (the part after tests/test-meta-) that read $1 by glob or scan; `none` when every
# scan excludes it; empty when this table cannot say.
meta_areas() {
  case "$1" in
    docs/verification/*|docs/retro/*|docs/handoff/*|docs/research/*|docs/CHANGELOG.md|CHANGELOG.md|_meta/*) echo none ;;
    docs/specs/*|docs/decisions/*) echo "docs-registry" ;;
    docs/FEATURES.md) echo "docs-registry plugin-hooks vmodel-dispatch" ;;
    commands/*|agents/*) echo "agents-commands review-verifiers vmodel-dispatch plugin-hooks docs-registry" ;;
    skills/*) echo "agents-commands review-verifiers vmodel-dispatch plugin-hooks docs-registry" ;;
    hooks/*) echo "plugin-hooks vmodel-dispatch docs-registry" ;;
    settings.json) echo "plugin-hooks contract docs-registry" ;;
    install.sh) echo "plugin-hooks contract" ;;
    .claude-plugin/*|VERSION|tool.toml) echo "plugin-hooks" ;;
    .github/workflows/*) echo "docs-registry" ;;
    examples/*) echo "contract docs-registry" ;;
    tests/fixtures/gates-on*) echo "$META_ALL" ;;
    tests/test-hooks.sh) echo "docs-registry" ;;
    tests/test-e2e.sh) echo "vmodel-dispatch" ;;
    lib/ledger/*|lib/spec/*|lib/gate/lane-data.sh|lib/telemetry/kit-log-dir.sh) echo "plugin-hooks goal-ledger vmodel-dispatch" ;;
    lib/*.md) echo "plugin-hooks" ;;
    lib/*/tests/*) echo "docs-registry" ;;
    lib/*) kit_verb_file "$1" && echo "docs-registry" || true ;;
    docs/*.md|docs/*/*.md|WORKFLOW.md|README.md|MANUAL.md|AGENTS.md) echo "plugin-hooks vmodel-dispatch" ;;
    *.md) echo "plugin-hooks" ;;
  esac
}

# Print the pairs for changed path $1 ($2 = the suites that name it). Returns 0 when an area or the
# runner is picked, 1 when $1 is not a meta input, 2 when every scan excludes it.
meta_pick() {
  local f="$1" hits="$2" a t areas picked=0 none=0
  [ -f tests/test-meta.sh ] || return 1
  meta_input "$f" || return 1
  areas="$(meta_areas "$f")"
  for a in $areas; do
    if [ "$a" = none ]; then none=1; continue; fi
    t="tests/test-meta-$a.sh"
    if [ -f "$t" ]; then printf '%s\treads %s\n' "$t" "$f"; picked=1; fi
  done
  [ "$picked" = 1 ] && return 0
  [ "$none" = 1 ] && return 2
  for a in $META_ALL; do
    case "$hits" in *"tests/test-meta-$a.sh"*) return 0 ;; esac
  done
  printf 'tests/test-meta.sh\treads %s (no area attributed)\n' "$f"
}

# --- selection: "<test>\t<reason>" pairs and UNCOVERED files ---
: >"$TMP/pairs"; : >"$TMP/uncovered"
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    tests/test-*.sh)
      [ -f "$f" ] && printf '%s\tself\n' "$f" >>"$TMP/pairs"
      meta_pick "$f" "" >>"$TMP/pairs" || true
      continue ;;
  esac
  if is_source "$f"; then
    b="$(basename "$f")"
    pats="$f"
    [ "${#b}" -gt 5 ] && pats="$f
$b"
    hits="$(refs_any "$pats" tests/test-*.sh || true)"
  else
    hits="$(refs_exact "$f" tests/test-*.sh || true)"
  fi
  # A lib/<mod>/ change also picks the suites named for the module: tests/test-<mod>*.sh.
  # lib/wrap/ is split one suite per module: wrap-<stem>.sh -> test-wrap-<stem>.sh only,
  # report-lint.sh -> test-wrap-report-lint.sh, and the shared wrap.sh / wrap-common.sh
  # fan out to every standalone suite. The compatibility runner (tests/test-wrap.sh)
  # matches no `test-wrap-*` glob, so it is never picked here.
  covered=0
  case "$f" in
    lib/wrap/wrap.sh|lib/wrap/wrap-common.sh)
      for t in tests/test-wrap-*.sh; do
        [ -f "$t" ] || continue
        printf '%s\tmodule lib/wrap shared\n' "$t" >>"$TMP/pairs"; covered=1
      done ;;
    lib/wrap/wrap-rebase.sh)
      # The land and merge cycle calls the rebase resolver (_rb_resolve, _rb_markers), so
      # a resolver edit also picks the two suites that drive that cycle.
      for t in tests/test-wrap-rebase.sh tests/test-wrap-land.sh tests/test-wrap-merge.sh; do
        [ -f "$t" ] || continue
        printf '%s\tmodule %s\n' "$t" "${f#lib/}" >>"$TMP/pairs"; covered=1
      done ;;
    lib/wrap/wrap-*.sh)
      t="tests/test-wrap-${f#lib/wrap/wrap-}"
      if [ -f "$t" ]; then
        printf '%s\tmodule %s\n' "$t" "${f#lib/}" >>"$TMP/pairs"; covered=1
      fi ;;
    lib/wrap/report-lint.sh)
      if [ -f tests/test-wrap-report-lint.sh ]; then
        printf 'tests/test-wrap-report-lint.sh\tmodule %s\n' "$f" >>"$TMP/pairs"; covered=1
      fi ;;
    lib/*/*)
      mod="${f#lib/}"; mod="${mod%%/*}"
      for t in tests/test-"$mod"*.sh; do
        [ -f "$t" ] || continue
        printf '%s\tmodule lib/%s\n' "$t" "$mod" >>"$TMP/pairs"; covered=1
      done ;;
  esac
  if [ -n "$hits" ]; then
    covered=1
    printf '%s\n' "$hits" | while IFS= read -r t; do printf '%s\treferences %s\n' "$t" "$f"; done >>"$TMP/pairs"
  fi
  mrc=0; meta_pick "$f" "$hits" >>"$TMP/pairs" || mrc=$?
  [ "$mrc" = 0 ] && covered=1
  [ "$covered" = 1 ] || printf '%s\n' "$f" >>"$TMP/uncovered"
done <"$TMP/changed"
sort -u -o "$TMP/pairs" "$TMP/pairs"
cut -f1 "$TMP/pairs" | sort -u >"$TMP/selected"

if [ ! -s "$TMP/changed" ]; then echo "test-affected: no changes against $BASE"; exit 0; fi

if [ "$LIST" = 1 ]; then
  echo "test-affected: $(wc -l <"$TMP/changed" | tr -d ' ') changed files against $BASE"
  while IFS="$(printf '\t')" read -r t why; do printf '  %s  (%s)\n' "$t" "$why"; done <"$TMP/pairs"
  while IFS= read -r f; do printf '  UNCOVERED %s\n' "$f"; done <"$TMP/uncovered"
  exit 0
fi

# --- cache: fail closed. Any trouble with the dir means no reads, so everything runs. ---
CDIR=""
if [ "$NOCACHE" = 0 ]; then
  # shellcheck source=lib/telemetry/kit-log-dir.sh
  if source "$SELF_DIR/../lib/telemetry/kit-log-dir.sh" 2>/dev/null \
     && LOGDIR="$(kit_resolve_log_dir 2>/dev/null)" \
     && mkdir -p "$LOGDIR/test-cache" 2>/dev/null \
     && [ -r "$LOGDIR/test-cache" ] && [ -w "$LOGDIR/test-cache" ] && [ -x "$LOGDIR/test-cache" ]; then
    CDIR="$LOGDIR/test-cache"
  else
    echo "test-affected: cache unusable; running without it" >&2
  fi
fi

# The test, the sources it names (path or basename, the same scan the selector uses), VERSION.
cache_key() {
  {
    printf 'test %s\n' "$(sha <"$1")"
    printf 'version %s\n' "$(cat VERSION 2>/dev/null || true)"
    grep -oFf "$TMP/pats" "$1" 2>/dev/null | awk '{print; n=split($0,a,"/"); print a[n]}' | sort -u \
      | awk -F'\t' 'NR==FNR{m[$1]=m[$1] $2 "\n"; next} ($0 in m){printf "%s", m[$0]}' "$TMP/map" - \
      | sort -u | while IFS= read -r s; do if [ -n "$s" ]; then printf '%s %s\n' "$s" "$(sha <"$s")"; fi; done || true
  } | sha
}

_timeout() { if command -v timeout >/dev/null 2>&1; then timeout "$@"; else shift; "$@"; fi; }

# Per-suite limit: TEST_AFFECTED_TIMEOUT_SECS when set (it wins for every suite), else the suite's
# line in bin/test-affected.timeouts (tests/run-all.sh reads the same file), else 300.
suite_timeout() {
  local name; name="$(basename "$1" .sh)"
  if [ -n "${TEST_AFFECTED_TIMEOUT_SECS:-}" ]; then echo "$TEST_AFFECTED_TIMEOUT_SECS"; return; fi
  if [ -r "$SELF_DIR/test-affected.timeouts" ]; then
    awk -v n="$name" '$1 == n && $2 ~ /^[0-9]+$/ { print $2; exit }' "$SELF_DIR/test-affected.timeouts"
  fi
}

P=0 C=0 F=0 T=0 N=0
while IFS= read -r t; do
  N=$((N + 1))
  key="$(cache_key "$t")"
  if [ -n "$CDIR" ] && grep -q '^PASS ' "$CDIR/$key" 2>/dev/null; then
    echo "CACHED $t"; C=$((C + 1)); continue
  fi
  limit="$(suite_timeout "$t")"; limit="${limit:-300}"
  rc=0; _timeout "$limit" bash "$t" >"$TMP/out" 2>&1 || rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "PASS $t"; P=$((P + 1))
    [ -n "$CDIR" ] && printf 'PASS %s\n' "$t" >"$CDIR/$key" 2>/dev/null || true
  elif [ "$rc" -eq 124 ] && command -v timeout >/dev/null 2>&1; then
    echo "TIMEOUT $t (limit ${limit}s)"; T=$((T + 1))
    echo "    | killed at ${limit}s; no assertion failed, the suite ran out of time (re-run it alone, or TEST_AFFECTED_TIMEOUT_SECS=<n>)"
  else
    echo "FAIL $t"; F=$((F + 1))
    tail -8 "$TMP/out" | sed 's/^/    | /'
  fi
done <"$TMP/selected"
U="$(wc -l <"$TMP/uncovered" | tr -d ' ')"
while IFS= read -r f; do echo "UNCOVERED $f"; done <"$TMP/uncovered"
echo "test-affected: $N selected, $P pass, $C cached, $F fail, $T timeout, $U uncovered"
[ "$F" -eq 0 ] && [ "$T" -eq 0 ]
