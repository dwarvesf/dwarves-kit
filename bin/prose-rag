#!/usr/bin/env bash
# bin/prose-rag -- STABLE consumer entrypoint, an ALIAS over context-kit's ctx.
# The engine folded into `ctx` (context-kit CK-8): `prose-rag <verb> <args>`
# maps to `ctx <verb> <args>`, the verbs index/query/hook, the flags, and the
# PROSE_RAG_* env are the unchanged consumer contract, and the `prose-rag` name
# is kept INDEFINITELY (a UserPromptSubmit hook, a weekly job, and muscle
# memory all call it). This shim only RESOLVES the engine, in the order
# `config seams` reports for the PROSE_RAG_BIN row:
#   1. $PROSE_RAG_BIN, a regular executable file (it may name ctx, context-
#      kit's own prose-rag alias, or a pre-fold binary -- identical argv).
#   2. `ctx` on PATH -- the folded engine's primary spelling.
#   3. `prose-rag` on PATH -- a pre-fold binary, still valid.
# It never builds and never looks under lib/.
# `hook` with no engine exits 0: a recall hook must never break a prompt.
# The lookup itself is `lib/prose-rag/resolve.sh`, shared with
# `config seams` so the two readers cannot drift.
set -euo pipefail

_PROSE_RAG_SHIM_SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# A COPY of this file outside a kit checkout has no lib/ beside it. It still owes the
# documented exits, so a missing resolver degrades to "no engine". The readability test
# comes FIRST because bash 3.2 (Apple's /bin/bash) exits the whole shell when `source`
# cannot find the file, `if !` or no `if !`.
_PROSE_RAG_RESOLVER="$_PROSE_RAG_SHIM_SELF/../lib/prose-rag/resolve.sh"
if [ -r "$_PROSE_RAG_RESOLVER" ]; then
  # shellcheck source=lib/prose-rag/resolve.sh
  source "$_PROSE_RAG_RESOLVER"
else
  prose_rag_engine_resolve() { return 1; }
fi

# A consumer may put THIS shim on PATH as `prose-rag`; the resolver skips it by realpath,
# and a kit wrapper by its marker line. The marker below is the second line of defence:
# it survives exec, so a second entry skips resolution and falls through to the no-engine
# contract instead of recursing.
if [ -z "${PROSE_RAG_SHIM_ACTIVE:-}" ]; then
  export PROSE_RAG_SHIM_ACTIVE=1
  if bin="$(prose_rag_engine_resolve)" && [ -n "$bin" ]; then
    exec "$bin" "$@"
  fi
fi

[ "${1:-}" = "hook" ] && exit 0
# `index` with no corpus configured = an unconfigured consumer (the shipped
# kit-weekly job): skip clean, same contract as the engine's own guard. An
# explicit --corpus means someone is driving interactively -> honest error.
if [ "${1:-}" = "index" ] && [ -z "${PROSE_RAG_CORPUS:-}" ] && [[ "$*" != *"--corpus"* ]]; then
  echo "prose-rag: no corpus configured (set PROSE_RAG_CORPUS or pass --corpus); nothing indexed"
  exit 0
fi
echo "prose-rag: engine not installed; install context-kit's binary: cargo install --path <context-kit>/src/ctx (or set PROSE_RAG_BIN)" >&2
exit 1
