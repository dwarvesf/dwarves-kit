#!/usr/bin/env bash
# bin/session -- STABLE consumer entrypoint for the session subsystem (SPEC-184,
# ADR-0034 decision 7). Collapses the five prefixed `bin/session-*` CLIs
# (session-intel, session-observe, session-recall, session-report,
# session-semantic) into one `session <verb>` grammar; deep lib paths unchanged.
#
# Consumers reference THIS stable path, never a deep `$DWARVES_KIT/lib/session/<x>`
# path, so an internal lib reorg never breaks them again.
#
# Usage: session <intel|observe|recall|report|semantic> <args...>
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "$SELF_DIR/../lib/session/session.sh" "$@"
