#!/usr/bin/env bash
# bin/plugin-check -- STABLE consumer entrypoint for the plugin-check subsystem.
#
# SPEC-200 C2 (wiring): a module executable that no operator surface reaches is a tool
# nobody runs. plugin-check lived only at its deep lib path until 2026-07-14.
#
# Usage: plugin-check [--json] ...   (forwards to lib/plugin-check/bin/plugin-check)
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "$SELF_DIR/../lib/plugin-check/bin/plugin-check" "$@"
