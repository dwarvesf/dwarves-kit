#!/usr/bin/env bash
# bin/skill-improve -- STABLE operator entrypoint for the skill-curator subsystem.
#
# SPEC-200 C2: the rename to skill-improve left it reachable from NO operator surface
# (the exempt list hid it; the advisor caught it). A tool nobody can invoke is a tool
# nobody runs.
#
# Usage: skill-improve {status|curate [--apply]|restore <name>}
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "$SELF_DIR/../lib/skill-curator/bin/skill-improve" "$@"
