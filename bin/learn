#!/usr/bin/env bash
# bin/learn -- STABLE consumer entrypoint for the learn subsystem.
#
# Consumers reference THIS stable path, never a deep `$DWARVES_KIT/lib/learn/<file>.sh`
# path. Forwards to the learn subsystem entry, which owns the verb grammar.
#
# The header used to say `propose`/`drain` REFUSE ("not shipped yet"). They shipped;
# the header never caught up, so the module's own front door told you its two main verbs
# did not work (found 2026-07-15).
#
# Usage:
#   learn propose [--days N | --megas N]        cross-run proposals from the ledger
#   learn propose --retro <RETRO.md>            a retro's action items
#   learn drain [--days N]                      render the staging pile for review
#   learn debt <list|collect|mark-paid>         understanding-debt paydown (weekend-batch)
#
# Every proposal path above ends at the staging buffer as a `## [staged]` block; a human
# promotes with `board promote`. Nothing here writes a board.
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "$SELF_DIR/../lib/learn/learn.sh" "$@"
