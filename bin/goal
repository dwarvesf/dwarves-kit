#!/usr/bin/env bash
# bin/goal -- STABLE consumer entrypoint for the goal subsystem (SPEC-184,
# ADR-0034 decision 7: every subsystem gets its bin entry).
#
# Consumers reference THIS stable path, never a deep `$DWARVES_KIT/lib/goal/<file>.sh`
# path, so an internal lib reorg never breaks them again. Forwards to the goal
# subsystem entry, which owns the verb grammar.
#
# Usage: goal <draft|registry|merge|stack-merge|handoff> <args...>
#   e.g. goal registry claim <slug>   -> the cross-session goal lock
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "$SELF_DIR/../lib/goal/goal.sh" "$@"
