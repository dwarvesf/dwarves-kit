#!/usr/bin/env bash
# bin/spec -- STABLE consumer entrypoint for the spec subsystem (SPEC-184,
# ADR-0034 decision 7: every subsystem gets its bin entry).
#
# Consumers reference THIS stable path, never a deep `$DWARVES_KIT/lib/spec/<file>.sh`
# path, so an internal lib reorg never breaks them again. Forwards to the spec
# subsystem entry, which owns the verb grammar.
#
# Usage: spec <index|next> <args...>
#   e.g. spec next reserve   -> atomic SPEC-number reservation
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "$SELF_DIR/../lib/spec/spec.sh" "$@"
