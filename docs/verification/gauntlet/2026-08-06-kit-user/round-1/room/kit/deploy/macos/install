#!/usr/bin/env bash
# Render + bootstrap the ONE kit-weekly LaunchAgent (macOS, gui domain).
# Idempotent: re-running re-renders and restarts the agent. Retires the per-job
# session-intel-weekly agent if a previous install left it loaded (ADR-0034
# decision 9: its job now rides the kit-weekly jobs list).
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT="$(cd "$HERE/../.." && pwd)"
PLIST="$HOME/Library/LaunchAgents/kit-weekly.plist"
mkdir -p "$HOME/.claude/intel" "$HOME/Library/LaunchAgents"

# Retire the pre-ADR per-job agent (no-op when it was never installed).
OLD="$HOME/Library/LaunchAgents/session-intel-weekly.plist"
if [ -f "$OLD" ]; then
  launchctl bootout "gui/$(id -u)/session-intel-weekly" 2>/dev/null || true
  mv "$OLD" "$OLD.retired"
  echo "[ok] session-intel-weekly retired (plist kept as $OLD.retired; its job now rides kit-weekly)"
fi

sed -e "s#__HOME__#$HOME#g" -e "s#__KIT__#$KIT#g" \
  "$HERE/kit-weekly.plist.tmpl" > "$PLIST"
launchctl bootout "gui/$(id -u)/kit-weekly" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$PLIST"
launchctl print "gui/$(id -u)/kit-weekly" | grep -q "kit-weekly" \
  && echo "[ok] kit-weekly installed (Mon 09:00; kickstart to run now)"
