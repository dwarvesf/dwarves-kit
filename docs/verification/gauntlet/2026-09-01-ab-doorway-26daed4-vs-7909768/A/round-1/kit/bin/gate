#!/usr/bin/env bash
# bin/gate -- STABLE consumer entrypoint for the gate subsystem (SPEC-184).
#
# Consumers (incl. the adopt-injected CLAUDE.md block) reference THIS stable path, never
# a deep `$DWARVES_KIT/lib/gate/<file>.sh` path, so an internal lib reorg never breaks
# them again. Forwards to the gate subsystem entry, which owns the verb grammar
# (`gate ledger ...` -> gate-ledger.sh, `gate proof ...` -> proof-gate.sh, etc.).
#
# Usage: gate <ledger|dispatch|proof|proof-ledger|proof-table|quiz|...> <args...>
#   e.g. gate ledger record <rid> <Phase> ran "<note>"
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "$SELF_DIR/../lib/gate/gate.sh" "$@"
