#!/usr/bin/env bash
# bin/stats -- STABLE consumer entrypoint for the stats subsystem (SPEC-184,
# ADR-0034 decision 7: every subsystem gets its bin entry).
#
# The stats engine is the uv-managed Python CLI at lib/stats/ (SPEC-182: a
# stateless read-only projection over the append-only ledgers). This wrapper
# forwards through `uv run --project` so a consumer types `stats <cmd>` from
# anywhere instead of cd-ing into lib/stats first. Requires `uv` on PATH
# (the module's existing dependency, unchanged here).
#
# Usage: stats <rebuild|tables|show|query|render|anomalies|...> <args...>
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
command -v uv >/dev/null 2>&1 || { echo "stats: uv not found on PATH (the stats module is a uv-managed Python CLI; install uv or run it via 'uv run --project $SELF_DIR/../lib/stats stats ...')" >&2; exit 1; }
exec uv run --project "$SELF_DIR/../lib/stats" --quiet stats "$@"
