#!/usr/bin/env python3
"""prose-rag: semantic retrieval over your own prose, injected per prompt.

Indexes a markdown corpus (PROSE_RAG_CORPUS, colon-separated paths; e.g. a knowledge
base + research notes + a learned-ledger) into a local sqlite-vec store using a local embedding model on the Air (fastembed,
bge-small, 384-d). Then:

  index            build/refresh the index
  query "<text>"   rank the most relevant prior notes
  hook             UserPromptSubmit hook: inject top matches as context (stdin payload)

Everything is local: no prose leaves the machine, no cloud embedder. Retrieval is
brute-force cosine over the corpus (a few thousand chunks at most), so no ANN index
is needed and a query is a few ms once the model is loaded.

Latency note: the per-process model load is ~250ms (fastembed cold start), so the
`hook` path adds ~250ms per prompt. That misses the original <100ms aspiration; a
warm embedding daemon would close it but is deliberately not built for v1 (the
index/query value stands alone and the hook is opt-in). See docs/implementation-notes.
"""
import argparse
import json
import os
import re
import sys

HOME = os.path.expanduser("~")
DEFAULT_DB = os.environ.get("PROSE_RAG_DB", os.path.join(HOME, ".claude/prose-rag/index.db"))
# Corpus is consumer config (adapter-default invariant: no personal path baked in).
# Colon-separated dirs/files; unset = empty corpus (index errors with guidance).
DEFAULT_CORPUS = [
    os.path.expanduser(p) for p in os.environ.get("PROSE_RAG_CORPUS", "").split(":") if p
]
MODEL = os.environ.get("PROSE_RAG_MODEL", "BAAI/bge-small-en-v1.5")
CHUNK_MAX = 1500   # chars embedded per chunk
CHUNK_MIN = 40     # skip chunks shorter than this
HEADING_RE = re.compile(r"(?m)^#{1,3} ")

_model = None


def embedder():
    """Lazy-load fastembed so --help / argparse stay fast."""
    global _model
    if _model is None:
        from fastembed import TextEmbedding
        # ponytail: cap ONNX intra-op threads, default 4. Uncapped, fastembed pegs
        # every core (~286% CPU on a 10-core M4) during a full re-embed and makes the
        # machine unusable. 4 keeps index responsive; raise via PROSE_RAG_THREADS if idle.
        threads = int(os.environ.get("PROSE_RAG_THREADS", "4"))
        _model = TextEmbedding(MODEL, threads=threads)
    return _model


def embed(texts):
    return [list(map(float, v)) for v in embedder().embed(list(texts))]


def connect(db_path, create_parent=False):
    import sqlite3
    import sqlite_vec
    if create_parent:
        os.makedirs(os.path.dirname(db_path), exist_ok=True)
    db = sqlite3.connect(db_path)
    db.enable_load_extension(True)
    sqlite_vec.load(db)
    db.enable_load_extension(False)
    return db


def chunk_markdown(text):
    """Split a markdown doc into heading-anchored chunks. No headings -> one chunk."""
    text = text.strip()
    if not text:
        return []
    # Indices where a heading line starts.
    starts = [m.start() for m in HEADING_RE.finditer(text)]
    if not starts or starts[0] != 0:
        starts = [0] + starts
    spans = []
    for i, s in enumerate(starts):
        e = starts[i + 1] if i + 1 < len(starts) else len(text)
        spans.append(text[s:e].strip())
    out = []
    for span in spans:
        if len(span) < CHUNK_MIN:
            continue
        first = span.splitlines()[0] if span.splitlines() else ""
        heading = first.lstrip("# ").strip()[:120]
        if len(span) <= CHUNK_MAX:
            out.append((heading, span))
            continue
        # Window long spans on line boundaries instead of truncating: a heading
        # section longer than CHUNK_MAX (e.g. the VERDICTS.md table) would
        # otherwise lose everything past the first CHUNK_MAX chars.
        buf = ""
        for ln in span.splitlines(keepends=True):
            if buf and len(buf) + len(ln) > CHUNK_MAX:
                if len(buf.strip()) >= CHUNK_MIN:
                    out.append((heading, buf.strip()))
                buf = ""
            buf += ln
        if len(buf.strip()) >= CHUNK_MIN:
            out.append((heading, buf.strip()))
    return out


def gather(corpus):
    """Yield (source, heading, text) for every markdown chunk in the corpus."""
    for path in corpus:
        if os.path.isfile(path) and path.endswith(".md"):
            files = [path]
        elif os.path.isdir(path):
            files = []
            for dp, _d, fns in os.walk(path):
                if "/." in dp:
                    continue
                files += [os.path.join(dp, f) for f in fns if f.endswith(".md")]
        else:
            continue
        for f in files:
            try:
                text = open(f, encoding="utf-8").read()
            except OSError:
                continue
            src = os.path.relpath(f, os.path.dirname(path.rstrip("/"))) if os.path.isdir(path) else os.path.basename(f)
            for heading, body in chunk_markdown(text):
                yield (src, heading, body)


def cmd_index(args):
    import sqlite_vec
    corpus = args.corpus or [p for p in DEFAULT_CORPUS if os.path.exists(p)]
    chunks = list(gather(corpus))
    if not chunks:
        print("prose-rag: no markdown chunks found in corpus", file=sys.stderr)
        return 1
    print(f"prose-rag: embedding {len(chunks)} chunks from {len(corpus)} sources...", file=sys.stderr)
    vecs = embed([c[2] for c in chunks])
    db = connect(args.db, create_parent=True)
    db.execute("DROP TABLE IF EXISTS chunks")
    db.execute("CREATE TABLE chunks (id INTEGER PRIMARY KEY, source TEXT, heading TEXT, text TEXT, embedding BLOB)")
    db.executemany(
        "INSERT INTO chunks (source, heading, text, embedding) VALUES (?,?,?,?)",
        [(c[0], c[1], c[2], sqlite_vec.serialize_float32(v)) for c, v in zip(chunks, vecs)],
    )
    db.commit()
    print(f"prose-rag: indexed {len(chunks)} chunks -> {args.db}", file=sys.stderr)
    return 0


def search(db_path, text, k, floor):
    import sqlite_vec
    if not os.path.exists(db_path):
        return None
    db = connect(db_path)
    q = sqlite_vec.serialize_float32(embed([text])[0])
    rows = db.execute(
        "SELECT source, heading, text, vec_distance_cosine(embedding, ?) AS dist "
        "FROM chunks ORDER BY dist LIMIT ?",
        (q, k),
    ).fetchall()
    hits = []
    for source, heading, ctext, dist in rows:
        sim = 1.0 - float(dist)
        if sim >= floor:
            hits.append({"source": source, "heading": heading, "sim": round(sim, 3), "text": ctext})
    return hits


def cmd_query(args):
    hits = search(args.db, args.text, args.k, args.floor)
    if hits is None:
        print(f"prose-rag: no index at {args.db}; run `prose-rag index` first", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps([{k: h[k] for k in ("source", "heading", "sim")} for h in hits], indent=2))
        return 0
    if not hits:
        print("(no matches above floor)")
        return 0
    for h in hits:
        head = f" :: {h['heading']}" if h["heading"] else ""
        print(f"[{h['sim']:.2f}] {h['source']}{head}")
    return 0


# Precision-biased recall markers: only these phrasings pass the hook gate, so the
# ~250ms embed is skipped on operational prompts (edits, git, "fix this"). Misses are
# acceptable; the prose-rag skill covers explicit on-demand recall.
RECALL_MARKERS = (
    "have i ", "have we ", "did i ", "did we ", "didn't i", "didn't we",
    "what did i", "what did we", "what do my notes", "do i have notes",
    "did i already", "already solved", "already figure", "search my notes",
    "my notes on", "wrote about", "noted about", "what did i conclude",
    "have i written", "have i covered", "conclude about", "didn't we already",
)


def looks_like_recall(prompt):
    """Cheap (pure-string) gate: does this prompt ask about my prior work?"""
    low = prompt.lower()
    return any(m in low for m in RECALL_MARKERS)


def cmd_hook(args):
    """UserPromptSubmit hook: emit relevant prior notes as additionalContext.

    Opt-in + gated so it earns its latency:
      - master switch: silent unless PROSE_RAG_INJECT=1 (or --force). Lets the hook be
        wired into settings.json but stay dormant until I flip the env (controlled rollout).
      - recall gate: skip the embed entirely on non-recall prompts (bypass with --no-gate
        or PROSE_RAG_NO_GATE=1), so operational prompts pay ~0ms, not ~250ms.
    """
    if os.environ.get("PROSE_RAG_INJECT") != "1" and not args.force:
        return 0
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return 0
    prompt = payload.get("prompt") or payload.get("lastPrompt") or ""
    if not prompt.strip():
        return 0
    gate_off = args.no_gate or os.environ.get("PROSE_RAG_NO_GATE") == "1"
    if not gate_off and not looks_like_recall(prompt):
        return 0  # operational prompt: skip the embed (no model load, ~0ms)
    hits = search(args.db, prompt, args.k, args.floor)
    if not hits:
        return 0
    lines = ["Relevant prior notes (prose-rag, may help, may not):"]
    for h in hits:
        head = f" :: {h['heading']}" if h["heading"] else ""
        lines.append(f"- {h['source']}{head} (sim {h['sim']:.2f})")
    print("\n".join(lines))
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="prose-rag", description="Semantic retrieval over my own prose.")
    sub = p.add_subparsers(dest="cmd", required=True)

    pi = sub.add_parser("index", help="build/refresh the index")
    pi.add_argument("--corpus", action="append", help="corpus path (repeatable; default $PROSE_RAG_CORPUS)")
    pi.add_argument("--db", default=DEFAULT_DB)

    pq = sub.add_parser("query", help="rank relevant prior notes")
    pq.add_argument("text")
    pq.add_argument("--db", default=DEFAULT_DB)
    pq.add_argument("--k", type=int, default=5)
    pq.add_argument("--floor", type=float, default=0.55)  # baseline bge noise ~0.5; real matches 0.7+
    pq.add_argument("--json", action="store_true")

    ph = sub.add_parser("hook", help="UserPromptSubmit hook (reads stdin payload)")
    ph.add_argument("--db", default=DEFAULT_DB)
    ph.add_argument("--k", type=int, default=4)
    ph.add_argument("--floor", type=float, default=0.62)  # higher: only inject confident matches per prompt
    ph.add_argument("--force", action="store_true", help="bypass the PROSE_RAG_INJECT master switch (testing)")
    ph.add_argument("--no-gate", action="store_true", help="bypass the recall-shape gate (always search when enabled)")

    args = p.parse_args(argv)
    return {"index": cmd_index, "query": cmd_query, "hook": cmd_hook}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
