#!/usr/bin/env python3
"""session-observe: read Claude Code session transcripts and report my own usage.

Three views, all derived from the JSONL transcripts under ~/.claude/projects/:
  skills    - which Skills fired, how often, with what error rate
              (--latency adds a per-skill total wall-time table, ranked by summed ms)
  tools     - which tools (Bash/Read/Edit/Agent/...) fired, with error rate
              (--errors TOOL groups that tool's error results by message prefix)
  hooks     - per-hook execution latency (count/p50/p95/max) + hook errors
  subagents - subagent (Agent/Task) spawns per day + by type, normalized per prompt
  friction  - deterministic friction: thrash (rework), permission-prompts, context
              pressure (compactions), skill mis-fires
  sessions  - session shape: archetype mix, circadian (by hour), interruption rate
  cost      - tokens by model + cache economics + $ estimate (attribution, not a bill)
  entry-fee - the fixed preamble every turn re-reads before any work: a measured
              per-session total, an estimated per-component split, a per-repo
              figure, and with --trend a weekly median so a reduction is visible;
              not part of `report` (report is the weekly digest of behaviour,
              entry-fee is a standing cost measurement)
  burn      - live per-session token burn in the last --since minutes (default 60),
              ranked by burn rate; subagent transcripts roll into their parent session;
              `model share` splits each row by model (priced, so an Opus fan-out is
              visible at a glance); not part of `report` (report is the weekly digest,
              burn is a live check)
  report    - all of the above, the weekly self-observability digest

The subagents view answers "is my subagent mix drifting?" that a raw tool count
hides: it splits spawns by subagent_type (Explore vs general-purpose vs reviewer
...) and normalizes by user-prompt turns (per100 = spawns per 100 prompts), so a
busy day and a quiet day are comparable. Sidechain entries (the subagents' own
transcripts) are excluded, so each spawn is counted once from the main session.

Why JSONL and not a hook wrapper: the transcript already records, per entry,
`hookInfos: [{command, durationMs}]` and `hookErrors`, plus every `tool_use`
and `tool_result` block. So hook latency AND tool/skill usage come from one
source with zero instrumentation, no dotfiles change, no always-on daemon.

Stdlib only (no external deps) so it can run anywhere, including from a hook.
"""
import argparse
import hashlib
import json
import os
import re
import sys
import time
from collections import Counter, defaultdict
from datetime import date, datetime


def _repo_root():
    """Walk up from this file to find the kit repo root (the dir holding
    lib/session/). Repo-relative per DECISIONS.md's adapter-default invariant:
    no hardcoded ops-toolkit/personal path, no CONSUMER_ROOT env."""
    d = os.path.dirname(os.path.realpath(__file__))
    for _ in range(8):
        if os.path.isdir(os.path.join(d, "lib", "session")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    raise RuntimeError("session-observe: cannot locate the kit repo root (lib/session not found)")


sys.path.insert(0, os.path.join(_repo_root(), "lib", "session"))
from parse_transcript import iter_entries as _iter_transcript_entries  # noqa: E402

DEFAULT_ROOT = os.path.expanduser("~/.claude/projects")

# A file edited this many+ times within one session is "thrash" (a rework/debug spiral).
THRASH_MIN = 3
# Real permission-friction markers in tool_result content. NOTE: the lowercase
# substring "permission to use" is a FALSE positive (it appears in skill-description
# text); the genuine prompt is capital-P "Permission to use <Tool> ...". Denials and
# config-fences are the other two.
PERM_MARKERS = ("Permission to use ", "doesn't want to proceed", "denied by your permission")
# Session archetype thresholds (minutes of wall-clock, count of tool_use). Order of
# tests matters: automation, marathon, deep, quick, else standard. Tunable here.
ARCH = {"marathon": (120, 300), "deep": (30, 80), "quick": (5, 15)}
# The user-message text a turn carries when interrupted mid-flight.
INTERRUPT_MARK = "[Request interrupted"
# skills view: a skill counts toward `14d` when its last Skill tool_use falls within
# this many days of "now" (SESSION_OBSERVE_NOW-overridable, same knob burn uses), so a
# rotting skill (fired long ago, still in the count column) is visible without a second scan.
SKILL_RECENT_DAYS = 14

# $/million tokens, approximate list price as of 2026-06-15, keyed by model-family
# substring: (input, output, cache_read, cache_write). Max-plan billing is flat-rate,
# so these are ATTRIBUTION estimates, not a bill. Unknown families (e.g. fable) count
# tokens but contribute no $ (shown as "?"). Update the date if you refresh prices.
PRICING = {
    "opus": (15.0, 75.0, 1.5, 18.75),
    "sonnet": (3.0, 15.0, 0.30, 3.75),
    "haiku": (0.80, 4.0, 0.08, 1.0),
}


def model_cost(model, t):
    """Estimated USD for one model's [input, output, cache_read, cache_write] tokens, or None if family unknown."""
    fam = next((f for f in PRICING if f in model), None)
    if not fam:
        return None
    inp, out, cr, cw = PRICING[fam]
    return (t[0] * inp + t[1] * out + t[2] * cr + t[3] * cw) / 1_000_000


def parse_ts(ts):
    """ISO timestamp -> datetime, or None. Handles the trailing Z."""
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except (ValueError, AttributeError):
        return None


def classify_session(dur_min, tools, turns):
    """Bucket a session by wall-clock + tool volume + whether a human prompted."""
    if turns == 0:
        return "automation"  # no human prompt = scheduled / subagent / non-interactive
    if dur_min > ARCH["marathon"][0] or tools > ARCH["marathon"][1]:
        return "marathon"
    if dur_min > ARCH["deep"][0] or tools > ARCH["deep"][1]:
        return "deep"
    if dur_min < ARCH["quick"][0] and tools < ARCH["quick"][1]:
        return "quick"
    return "standard"


def project_roots(root, project):
    """Directories to walk for --project.

    The exact slug dir when it exists (the historical contract). Otherwise every
    slug whose name contains the given string, so a bare repo name resolves
    without the full cwd-derived slug. One repo's worktrees each get their own
    slug, and a per-repo figure wants them together, so this returns all matches
    rather than picking one. No match -> the literal join, which walks nothing.

    A substring that matches more than one slug prints the resolved list to
    stderr. Before this fallback existed a wrong --project walked nothing and
    the empty output said so; a silent multi-match would instead merge unrelated
    repos into one plausible figure.
    """
    exact = os.path.join(root, project)
    if os.path.isdir(exact):
        return [exact]
    try:
        hits = sorted(
            os.path.join(root, n) for n in os.listdir(root)
            if project in n and os.path.isdir(os.path.join(root, n))
        )
    except OSError:
        hits = []
    if len(hits) > 1:
        print(f"session-observe: --project {project!r} matched {len(hits)} slugs: "
              + ", ".join(os.path.basename(h) for h in hits), file=sys.stderr)
    return hits or [exact]


def _walk_transcripts(args):
    """Every *.jsonl under the resolved roots, in a stable order."""
    root = args.root or DEFAULT_ROOT
    roots = project_roots(root, args.project) if args.project else [root]
    for r in roots:
        for dirpath, _dirs, files in os.walk(r):
            for fn in sorted(files):
                if fn.endswith(".jsonl"):
                    yield os.path.join(dirpath, fn)


def iter_files(args):
    """Resolve the set of transcript files to read from the CLI args."""
    if args.file:
        yield args.file
        return
    cutoff = time.time() - args.days * 86400 if args.days else None
    for path in _walk_transcripts(args):
        # Coarse window: skip files whose last write predates the cutoff.
        if cutoff is not None:
            try:
                if os.path.getmtime(path) < cutoff:
                    continue
            except OSError:
                continue
        yield path


def iter_entries(path):
    """Yield parsed JSON objects from one transcript, skipping unparseable lines.

    Delegates to the shared lib/session/parse_transcript.py (the ONE JSONL
    turn-parser session-observe and session-recall both need); this wrapper only adds
    the many-file-scan behavior session-observe wants (a single missing/unreadable
    file in a --root/--project sweep contributes zero entries rather than
    aborting the whole scan -- honest-zero for that file, not a crash)."""
    try:
        yield from _iter_transcript_entries(path)
    except OSError:
        return


def blocks(entry):
    """Content blocks of a user/assistant entry, or empty."""
    msg = entry.get("message")
    if not isinstance(msg, dict):
        return []  # e.g. message: "oops" (untrusted transcript)
    c = msg.get("content")
    return c if isinstance(c, list) else []


def result_text(content):
    """Text of a tool_result block: the string itself, or the joined text
    blocks of the list shape."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(str(x.get("text", "")) for x in content
                         if isinstance(x, dict) and x.get("text"))
    return ""


ERR_PREFIX_LEN = 160


def err_prefix(text):
    """Group key for an error message: whitespace-collapsed first
    ERR_PREFIX_LEN chars, so two reports of the same failure land in one
    table row and a newline inside the message never breaks the table."""
    return re.sub(r"\s+", " ", text).strip()[:ERR_PREFIX_LEN]


def hook_label(command):
    """Normalize a hook command string to a stable, mostly-readable label.

    Script hooks collapse to their basename (foo.sh), but only when the script is
    NAMED EARLY (within the first two whitespace tokens, i.e. it is the executable
    being run, optionally after a runner like `bash`/`node`). A long re-injected
    prompt such as a `/goal` Stop hook often MENTIONS a *.sh / *.py deep in its
    prose; matching that would mislabel the goal as that file (and merge unrelated
    goals onto one row), so the early-token guard keeps prose out of the script
    branch.

    Inline hooks have no stable first word: the `echo` guard hooks AND the long
    re-injected `/goal`-style prompts would otherwise each scatter into many rows,
    keyed by an arbitrary first word (Drive/Outcome:/Execute/...) or an incidentally
    mentioned filename. Both key on a short hash of the WHOLE command instead, so
    each UNIQUE inline hook collapses to a single stable `inline-echo:<hash>` row.
    Everything else uses its first token's basename.
    """
    c = command.strip()
    toks = c.split()
    m = re.search(r"([\w.-]+\.(?:sh|py|js|ts|rb|bash))\b", " ".join(toks[:2]))
    if m:
        return m.group(1)
    if c.startswith("echo") or len(c) > 120:
        return "inline-echo:" + hashlib.sha1(c.encode()).hexdigest()[:8]
    if not toks:
        return "?"
    return toks[0].rsplit("/", 1)[-1][:40] or "?"


def _rank_index(n, p):
    """Nearest-rank index into a sorted list of n values for percentile p.

    Shared so pctl() and entry_fee_median() cannot drift: the entry-fee view
    reports the component split of the session AT its median fee, and a drift
    here would stop that session reconciling against the median it is shown for.
    """
    return min(n - 1, int(round((p / 100) * (n - 1))))


def pctl(vals, p):
    """Nearest-rank percentile (integer ms). Empty -> 0."""
    if not vals:
        return 0
    s = sorted(vals)
    return int(s[_rank_index(len(s), p)])


def collect(args):
    """Single pass over all selected transcripts -> usage + latency tallies."""
    tool_n, tool_err = Counter(), Counter()
    tool_err_msg = defaultdict(Counter)  # tool -> error-message prefix -> count
    skill_n, skill_err = Counter(), Counter()
    id_tool, id_skill = {}, {}  # tool_use_id -> name (a tool_result references it)
    id_skill_ts = {}            # tool_use_id -> Skill tool_use timestamp (for wall-time)
    skill_durs = defaultdict(list)  # skill -> [wall-time ms], one per fire (ts(result)-ts(use))
    skill_last = {}             # skill -> latest Skill tool_use timestamp (ISO string, sortable)
    skill_recent = Counter()    # skill -> fires within SKILL_RECENT_DAYS of now
    hook_durs = defaultdict(list)
    hook_sample = {}
    hook_errors = 0
    files = 0
    sub_day = Counter()      # day -> subagent spawns (main sessions only)
    sub_type = Counter()     # subagent_type -> spawns
    turns_day = Counter()    # day -> user-prompt turns (the per100 denominator)
    thrash = Counter()       # file_path -> # sessions where it was edited >= THRASH_MIN times
    thrash_max = {}          # file_path -> worst single-session edit count
    perm = Counter()         # tool/cmd label -> permission-friction events
    id_cmd = {}              # tool_use_id -> short Bash command (for perm labeling)
    compact_day = Counter()  # day -> compaction events (context pressure)
    arch = Counter()         # session archetype -> # sessions
    circ = defaultdict(lambda: [0, 0])  # hour-of-day (UTC) -> [prompt turns, tool_uses]
    interruptions = 0        # total interrupted turns
    interrupt_sessions = 0   # sessions with >= 1 interruption
    tok = defaultdict(lambda: [0, 0, 0, 0])  # model -> [input, output, cache_read, cache_create]
    recent_cutoff = _burn_now() - SKILL_RECENT_DAYS * 86400

    for path in iter_files(args):
        files += 1
        file_edits = Counter()   # per-session edit counts, reset each transcript
        f_first = f_last = None  # session wall-clock bounds
        f_tools = f_turns = 0    # session tool + prompt volume (for archetype)
        f_interrupted = False
        f_sidechain = False      # a subagent's own transcript, not a session Han ran
        for entry in iter_entries(path):
            # day + sidechain are needed by both the prompt-turn count and the
            # subagent-spawn count; a spawn in a sidechain file is the subagent's
            # OWN run, not a spawn, so it must not be double-counted.
            ts = entry.get("timestamp")
            day = ts[:10] if isinstance(ts, str) and len(ts) >= 10 else None
            side = bool(entry.get("isSidechain"))
            if side:
                f_sidechain = True
            hour = ts[11:13] if isinstance(ts, str) and len(ts) >= 13 else None
            if isinstance(ts, str):
                if f_first is None:
                    f_first = ts
                f_last = ts
            # token economy: the usage block rides on assistant messages.
            # message/usage are untrusted transcript fields (e.g. message: "oops");
            # a non-dict here must not crash the .get() calls below.
            msg = entry.get("message")
            if not isinstance(msg, dict):
                msg = {}
            u = msg.get("usage")
            if isinstance(u, dict):
                t = tok[msg.get("model") or "?"]
                t[0] += u.get("input_tokens") or 0
                t[1] += u.get("output_tokens") or 0
                t[2] += u.get("cache_read_input_tokens") or 0
                t[3] += u.get("cache_creation_input_tokens") or 0
            # A prompt turn is a real user message (text), not a tool_result carrier.
            if entry.get("type") == "user" and not side and day:
                c = msg.get("content")
                has_text = isinstance(c, str) or any(
                    isinstance(b, dict) and b.get("type") == "text"
                    for b in (c if isinstance(c, list) else [])
                )
                if has_text:
                    turns_day[day] += 1
                    f_turns += 1
                    if hour:
                        circ[hour][0] += 1
                    txt = c if isinstance(c, str) else " ".join(
                        b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text")
                    if INTERRUPT_MARK in txt:
                        interruptions += 1
                        f_interrupted = True

            # context pressure: a compaction collapses the window mid-session.
            if entry.get("isCompactSummary") and day:
                compact_day[day] += 1

            # hookInfos/hookErrors ride on (mostly) system entries.
            hi = entry.get("hookInfos")
            if isinstance(hi, list):
                for h in hi:
                    if not isinstance(h, dict):
                        continue
                    lab = hook_label(str(h.get("command", "?")))
                    hook_durs[lab].append(h.get("durationMs") or 0)
                    hook_sample.setdefault(lab, str(h.get("command", ""))[:60])
            he = entry.get("hookErrors")
            if isinstance(he, list):
                hook_errors += len(he)

            for b in blocks(entry):
                if not isinstance(b, dict):
                    continue
                bt = b.get("type")
                if bt == "tool_use":
                    name = b.get("name") or "?"
                    tool_n[name] += 1
                    f_tools += 1
                    if hour:
                        circ[hour][1] += 1
                    tid = b.get("id")
                    if tid:
                        id_tool[tid] = name
                    if name == "Skill":
                        sk = (b.get("input") or {}).get("skill") or "?"
                        skill_n[sk] += 1
                        if tid:
                            id_skill[tid] = sk
                            if ts:
                                id_skill_ts[tid] = ts
                        if ts:
                            if sk not in skill_last or ts > skill_last[sk]:
                                skill_last[sk] = ts
                            dt = parse_ts(ts)
                            if dt and dt.timestamp() >= recent_cutoff:
                                skill_recent[sk] += 1
                    if name in ("Agent", "Task") and not side and day:
                        st = (b.get("input") or {}).get("subagent_type") or "(default)"
                        sub_day[day] += 1
                        sub_type[st] += 1
                    if name in ("Edit", "Write", "MultiEdit"):
                        fp = (b.get("input") or {}).get("file_path")
                        if fp:
                            file_edits[fp] += 1
                    if name == "Bash" and tid:
                        cmd = (b.get("input") or {}).get("command") or ""
                        id_cmd[tid] = cmd.split()[0][:24] if cmd.split() else ""
                elif bt == "tool_result":
                    tid = b.get("tool_use_id")
                    if b.get("is_error"):
                        if tid in id_tool:
                            tool_err[id_tool[tid]] += 1
                            tool_err_msg[id_tool[tid]][err_prefix(result_text(b.get("content")))] += 1
                        if tid in id_skill:
                            skill_err[id_skill[tid]] += 1
                    # per-skill wall-time: ts(tool_result) - ts(tool_use). The transcript
                    # carries no durationMs for a Skill, so the timestamp delta is the only
                    # honest source. Summed across fires, this surfaces death-by-a-thousand-
                    # cuts overhead a raw count hides (a 50ms skill firing 100x = 5s hidden).
                    if tid in id_skill and tid in id_skill_ts and ts:
                        a, b2 = parse_ts(id_skill_ts[tid]), parse_ts(ts)
                        if a and b2:
                            d = (b2 - a).total_seconds() * 1000.0
                            if d >= 0:
                                skill_durs[id_skill[tid]].append(d)
                    # permission friction: the prompt/denial rides in the result content.
                    content = b.get("content")
                    ctext = content if isinstance(content, str) else (json.dumps(content) if content is not None else "")
                    if any(m in ctext for m in PERM_MARKERS):
                        label = id_tool.get(tid, "?")
                        if label == "Bash" and tid in id_cmd and id_cmd[tid]:
                            label = "Bash:" + id_cmd[tid]
                        perm[label] += 1

        # end of transcript (= one session): fold per-session edit counts into thrash
        for fp, n in file_edits.items():
            if n >= THRASH_MIN:
                thrash[fp] += 1
                thrash_max[fp] = max(thrash_max.get(fp, 0), n)
        # classify the session by wall-clock + tool/prompt volume (skip subagent
        # transcripts, which are not sessions Han ran and would inflate "automation")
        if not f_sidechain:
            a, b2 = parse_ts(f_first), parse_ts(f_last)
            dur_min = (b2 - a).total_seconds() / 60.0 if a and b2 else 0.0
            arch[classify_session(dur_min, f_tools, f_turns)] += 1
            if f_interrupted:
                interrupt_sessions += 1

    return {
        "files": files,
        "tools": tool_n,
        "tool_err": tool_err,
        "tool_err_msg": tool_err_msg,
        "skills": skill_n,
        "skill_err": skill_err,
        "skill_durs": skill_durs,
        "skill_last": skill_last,
        "skill_recent": skill_recent,
        "hook_durs": hook_durs,
        "hook_sample": hook_sample,
        "hook_errors": hook_errors,
        "sub_day": sub_day,
        "sub_type": sub_type,
        "turns_day": turns_day,
        "thrash": thrash,
        "thrash_max": thrash_max,
        "perm": perm,
        "compact_day": compact_day,
        "arch": arch,
        "circ": circ,
        "interruptions": interruptions,
        "interrupt_sessions": interrupt_sessions,
        "tok": tok,
    }


def print_table(headers, rows):
    """Left/right-aligned fixed-width table. First column left, rest right."""
    if not rows:
        print("  (none)")
        return
    cols = list(zip(*([headers] + rows)))
    widths = [max(len(str(x)) for x in col) for col in cols]
    def fmt(row):
        out = [str(row[0]).ljust(widths[0])]
        out += [str(v).rjust(widths[i]) for i, v in enumerate(row[1:], 1)]
        return "  ".join(out)
    print("  " + fmt(headers))
    print("  " + "  ".join("-" * w for w in widths))
    for r in rows:
        print("  " + fmt(r))


def usage_rows(counts, errs, top):
    rows = []
    for name, n in counts.most_common(top or None):
        e = errs.get(name, 0)
        rate = f"{100 * e / n:.0f}%" if n else "0%"
        rows.append([name, n, e, rate])
    return rows


def skill_usage_rows(counts, errs, last, recent, top):
    """Like usage_rows, plus `14d` (fires within SKILL_RECENT_DAYS) and `last`
    (date of the most recent Skill tool_use), so a rotting skill (still counted,
    long unfired) shows without a second scan."""
    rows = []
    for name, n in counts.most_common(top or None):
        e = errs.get(name, 0)
        rate = f"{100 * e / n:.0f}%" if n else "0%"
        rows.append([name, n, e, rate, recent.get(name, 0), (last.get(name) or "")[:10] or "-"])
    return rows


def hook_rows(durs, sample, top):
    rows = []
    ranked = sorted(durs.items(), key=lambda kv: max(kv[1]) if kv[1] else 0, reverse=True)
    if top:
        ranked = ranked[:top]
    for lab, vals in ranked:
        rows.append([lab, len(vals), pctl(vals, 50), pctl(vals, 95), max(vals) if vals else 0, sample.get(lab, "")])
    return rows


def skill_latency_rows(skill_durs, top):
    """Per-skill total wall-time (ms), summed across every fire, sorted by total desc.

    Mirrors hook_rows (count/p50/p95/max) but ranks by TOTAL not max: a fast skill
    firing many times can out-cost a one-off slow skill. That total is the column
    the raw `skills` view (sorted by count) and the hooks view (sorted by max) both
    hide. Duration per fire = ts(tool_result) - ts(tool_use)."""
    ranked = sorted(skill_durs, key=lambda s: sum(skill_durs[s]), reverse=True)
    if top:
        ranked = ranked[:top]
    rows = []
    for s in ranked:
        v = skill_durs[s]
        rows.append([s, len(v), int(round(sum(v))), pctl(v, 50), pctl(v, 95), int(round(max(v))) if v else 0])
    return rows


def subagent_day_rows(sub_day, turns_day, top):
    """Per-day spawns with the per-100-prompts normalization (newest day first)."""
    rows = []
    for day in sorted(sub_day, reverse=True):
        n = sub_day[day]
        t = turns_day.get(day, 0)
        per100 = f"{100 * n / t:.1f}" if t else "-"
        rows.append([day, n, t, per100])
    return rows[:top] if top else rows


def subagent_type_rows(sub_type, top):
    total = sum(sub_type.values())
    return [
        [st, n, f"{100 * n / total:.0f}%" if total else "0%"]
        for st, n in sub_type.most_common(top or None)
    ]


def shorten_path(fp, n=48):
    parts = fp.split("/")
    s = "/".join(parts[-3:]) if len(parts) > 3 else fp
    return ("..." + s[-(n - 3):]) if len(s) > n else s


def thrash_rows(thrash, thrash_max, top):
    ranked = sorted(thrash, key=lambda fp: thrash_max.get(fp, 0), reverse=True)
    rows = [[shorten_path(fp), thrash[fp], thrash_max.get(fp, 0)] for fp in ranked]
    return rows[:top] if top else rows


def perm_rows(perm, top):
    return [[lab, n] for lab, n in perm.most_common(top or None)]


def compact_rows(compact_day, top):
    rows = [[d, compact_day[d]] for d in sorted(compact_day, reverse=True)]
    return rows[:top] if top else rows


def skill_precision_rows(skill_n, skill_err, top):
    """Only skills that ever mis-fired (errored), ranked by inert-rate. The raw
    `skills` view sorts by count and buries these; precision surfaces them."""
    ranked = sorted((s for s in skill_n if skill_err.get(s, 0)),
                    key=lambda s: skill_err[s] / skill_n[s], reverse=True)
    rows = [[s, skill_n[s], skill_err[s], f"{100 * skill_err[s] / skill_n[s]:.0f}%"] for s in ranked]
    return rows[:top] if top else rows


def cost_rows(tok, top):
    rows = []
    for model, t in tok.items():
        c = model_cost(model, t)
        rows.append([model, t[0], t[1], t[2], t[3], f"${c:.2f}" if c is not None else "?"])
    rows.sort(key=lambda r: float(r[5][1:]) if r[5] != "?" else -1, reverse=True)
    return rows[:top] if top else rows


def arch_rows(arch):
    order = ["quick", "standard", "deep", "marathon", "automation"]
    total = sum(arch.values())
    return [[a, arch[a], f"{100 * arch[a] / total:.0f}%" if total else "0%"] for a in order if arch.get(a)]


def circ_rows(circ, top):
    rows = [[h, circ[h][0], circ[h][1]] for h in sorted(circ)]
    return rows[:top] if top else rows


def _burn_now():
    """Wall-clock 'now' in epoch seconds. SESSION_OBSERVE_NOW overrides it (an
    epoch number or an ISO timestamp) so burn fixtures get a fixed, deterministic
    clock instead of the real one."""
    override = os.environ.get("SESSION_OBSERVE_NOW")
    if not override:
        return time.time()
    try:
        return float(override)
    except ValueError:
        dt = parse_ts(override)
        if dt is None:
            raise ValueError(f"SESSION_OBSERVE_NOW: cannot parse {override!r}")
        return dt.timestamp()


def _burn_session_id(path):
    """(sid, is_subagent) for a burn transcript path.
    Main:     <root>/<proj>/<sid>.jsonl
    Subagent: <root>/<proj>/<sid>/subagents/<agent>.jsonl -> rolls into <sid>.
    """
    d = os.path.dirname(path)
    if os.path.basename(d) == "subagents":
        return os.path.basename(os.path.dirname(d)), True
    return os.path.splitext(os.path.basename(path))[0], False


def _burn_files(args, cutoff_epoch):
    """Transcript files for burn: the same walk as iter_files(), but the coarse
    skip is an epoch-seconds cutoff (a minutes window), not iter_files' whole-day one."""
    if args.file:
        yield args.file
        return
    for path in _walk_transcripts(args):
        try:
            if os.path.getmtime(path) < cutoff_epoch:
                continue
        except OSError:
            continue
        yield path


# type -> field name, for the three known title-carrying entry shapes.
BURN_TITLE_FIELDS = {"ai-title": "aiTitle", "summary": "summary", "custom-title": "customTitle"}


def _burn_pid_map():
    """sessionId -> live pid, from ~/.claude/sessions/<pid>.json.
    SESSION_OBSERVE_PIDS_DIR overrides the directory for fixtures, which also
    skips the os.kill liveness probe (a fixture pid is never a real process)."""
    override = os.environ.get("SESSION_OBSERVE_PIDS_DIR")
    d = override or os.path.expanduser("~/.claude/sessions")
    check_live = not override
    out = {}
    try:
        names = os.listdir(d)
    except OSError:
        return out
    for fn in names:
        if not fn.endswith(".json"):
            continue
        pid_s = fn[: -len(".json")]
        if not pid_s.isdigit():
            continue
        pid = int(pid_s)
        if check_live:
            try:
                os.kill(pid, 0)
            except OSError:
                continue
        try:
            with open(os.path.join(d, fn), encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(data, dict):
            continue  # e.g. a pid file that is valid JSON but not an object
        sid = data.get("sessionId")
        if sid:
            out[sid] = pid
    return out


def burn_collect(args, now, cutoff):
    """Per-session live token burn in the window [cutoff, now]. A separate
    collector from collect(): a burn row is keyed by session + an entry-
    timestamp window, not aggregated by model + day like every other view."""
    sess = {}

    def row(sid):
        return sess.setdefault(sid, {
            "cwd": None, "reqs": 0, "input": 0, "cache_create": 0,
            "cache_read": 0, "output": 0, "sub_active": set(), "by_model": {},
            "title": None, "last_ts": None, "ctx": 0,
            "seen_keys": set(),
        })

    # main files before subagent files, so "the first entry carrying cwd" (per
    # the spec) is the main session's cwd when both exist.
    for path in sorted(_burn_files(args, cutoff), key=lambda p: _burn_session_id(p)[1]):
        sid, is_sub = _burn_session_id(path)
        r = row(sid)
        for entry in iter_entries(path):
            if not isinstance(entry, dict):
                continue  # malformed transcript line (untrusted input): skip, never crash
            ts = entry.get("timestamp")
            dt = parse_ts(ts) if isinstance(ts, str) else None
            epoch = dt.timestamp() if dt else None
            active = epoch is not None and epoch >= cutoff

            if r["cwd"] is None and entry.get("cwd"):
                r["cwd"] = entry["cwd"]

            field = BURN_TITLE_FIELDS.get(entry.get("type"))
            if field and entry.get(field):
                r["title"] = entry[field]

            if is_sub and active:
                r["sub_active"].add(path)

            if entry.get("type") != "assistant":
                continue
            msg = entry.get("message")
            if not isinstance(msg, dict):
                continue  # e.g. message: "oops" (untrusted transcript)
            u = msg.get("usage")
            if not isinstance(u, dict):
                continue
            side = bool(entry.get("isSidechain"))
            inp = u.get("input_tokens") or 0
            cc = u.get("cache_creation_input_tokens") or 0
            cr = u.get("cache_read_input_tokens") or 0
            out = u.get("output_tokens") or 0

            # ctx: live context = the LAST main-chain usage in FILE ITERATION
            # ORDER (spec), independent of timestamp -- a trailing main-chain
            # entry with no timestamp must still win over an earlier one.
            if not side:
                r["ctx"] = inp + cc + cr

            if not active:
                continue  # older than --since: not counted

            key = (msg.get("id"), entry.get("requestId"))
            if key != (None, None):
                if key in r["seen_keys"]:
                    continue  # a streamed chunk repeating the same usage block
                r["seen_keys"].add(key)
            # else: neither id present, nothing to dedup on; count every such entry
            r["reqs"] += 1
            r["input"] += inp
            r["cache_create"] += cc
            r["cache_read"] += cr
            r["output"] += out
            if msg.get("model"):
                # per-model [input, output, cache_read, cache_write], the tuple
                # order model_cost() takes, so a tier's share is priced not guessed
                t = r["by_model"].setdefault(msg["model"], [0, 0, 0, 0])
                t[0] += inp
                t[1] += out
                t[2] += cr
                t[3] += cc
            if r["last_ts"] is None or epoch > r["last_ts"]:
                r["last_ts"] = epoch

    return sess


def burn_rank(sess):
    """Rank key: input + cache_create + cache_read/10 + output*5 (the list-price
    ratios; attribution, not a bill). Sessions with zero counted entries are omitted."""
    ranked = [(sid, r) for sid, r in sess.items() if r["reqs"] > 0]
    ranked.sort(
        key=lambda kv: kv[1]["input"] + kv[1]["cache_create"] + kv[1]["cache_read"] / 10 + kv[1]["output"] * 5,
        reverse=True,
    )
    return ranked


def burn_model_share(by_model):
    """Per-model share of one session's burn, biggest first.

    Priced in USD via model_cost() when every model in the row has a known
    family. One unknown family (fable) makes dollars unavailable for that row,
    so the whole row falls back to the list-price TOKEN weight burn_rank uses
    and sets priced=False. Mixing the two units inside one row would compare
    dollars against tokens, so the fallback is all-or-nothing."""
    if not by_model:
        return [], True
    costs = {m: model_cost(m, t) for m, t in by_model.items()}
    priced = all(c is not None for c in costs.values())
    if not priced:
        costs = {m: t[0] + t[3] + t[2] / 10 + t[1] * 5 for m, t in by_model.items()}
    total = sum(costs.values())
    rows = [
        {"model": m, "weight": costs[m], "pct": (costs[m] / total * 100) if total else 0.0}
        for m in by_model
    ]
    rows.sort(key=lambda d: -d["weight"])
    return rows, priced


def burn_share_str(share, priced):
    """`opus 82% sonnet 18%`, dropping families under 1% so the column stays a
    glance. A tilde marks a row whose share is token-weighted, not priced."""
    shown = [d for d in share if d["pct"] >= 1.0] or share[:1]
    body = " ".join(f"{short_model(d['model'])} {d['pct']:.0f}%" for d in shown)
    return (body + " ~") if (body and not priced) else (body or "-")


def short_model(model):
    """`claude-opus-5` -> `opus`. Falls back to the full id for an unknown shape."""
    fam = next((f for f in PRICING if f in model), None)
    if fam:
        return fam
    return model.replace("claude-", "").split("-")[0] or model


def burn_row_dict(sid, r, now, pid_map):
    idle_min = int(round((now - r["last_ts"]) / 60.0)) if r["last_ts"] is not None else 0
    share, priced = burn_model_share(r["by_model"])
    title = r["title"] or "-"
    if len(title) > 40:
        title = title[:37] + "..."
    return {
        "session_id": sid,
        "pid": pid_map.get(sid),
        "cwd": r["cwd"],
        "reqs": r["reqs"],
        "subagents": len(r["sub_active"]),
        "ctx": r["ctx"],
        "input": r["input"],
        "cache_create": r["cache_create"],
        "cache_read": r["cache_read"],
        "output": r["output"],
        "idle_min": idle_min,
        "models": sorted(r["by_model"]),
        "model_share": share,
        "model_share_priced": priced,
        "title": title,
    }


def burn_table_row(d):
    return [
        d["session_id"][:8], d["pid"] if d["pid"] is not None else "-",
        shorten_path(d["cwd"]) if d["cwd"] else "-", d["reqs"], d["subagents"],
        d["ctx"], d["cache_create"], d["cache_read"], d["output"], d["idle_min"],
        burn_share_str(d["model_share"], d["model_share_priced"]), d["title"],
    ]


def run_burn(args):
    """The `burn` view: live per-session token burn. A separate I/O path from
    emit(): its own window/JSON shape, no model+day aggregation, and never part
    of `report` (report is the weekly digest, burn is a live check)."""
    now = _burn_now()
    since_min = args.since if args.since is not None else 60
    cutoff = now - since_min * 60
    sess = burn_collect(args, now, cutoff)
    pid_map = _burn_pid_map()
    ranked = burn_rank(sess)
    rows = [burn_row_dict(sid, r, now, pid_map) for sid, r in ranked]

    if args.json:
        print(json.dumps({"window_min": since_min, "sessions": rows}, indent=2))
        return

    shown = rows[: args.top] if args.top else rows
    tot_cw = sum(d["cache_create"] for d in rows)
    tot_cr = sum(d["cache_read"] for d in rows)
    tot_out = sum(d["output"] for d in rows)
    print(f"# burn  (window {since_min}m, {len(rows)} sessions; totals cache-wr {tot_cw}, cache-rd {tot_cr}, out {tot_out})")
    print_table(
        ["session", "pid", "cwd", "reqs", "subs", "ctx", "cache-wr", "cache-rd", "out", "idle", "model share", "title"],
        [burn_table_row(d) for d in shown],
    )


# --- entry fee -------------------------------------------------------------
# The fixed preamble every turn re-reads before the agent does any work: the
# skill listing, the CLAUDE.md stack, the repo memory index, the agent roster,
# the output style, the tool schemas.
#
# The TOTAL is measured. It is the first main-chain assistant turn's
# input + cache-creation + cache-read, which is exactly what the model read
# before it acted. The SPLIT is estimated: the transcript carries no per-component
# token count, so each preamble attachment is sized from its rendered text at
# ENTRY_FEE_CHARS_PER_TOKEN characters per token, the same rule of thumb the
# 2026-09-13 hand measurement used. Every output labels the split an estimate.
ENTRY_FEE_CHARS_PER_TOKEN = 4
# Fee minus the sized components: the system prompt and the built-in tool
# schemas reach the model but never appear in the transcript.
ENTRY_FEE_UNATTRIBUTED = "(unattributed)"
# The other direction: the estimate overshot the measured fee, so the split is
# wrong here and the row says so instead of printing a negative measurement.
ENTRY_FEE_OVERSHOT = "(estimate over measured)"
# Claude Code gives a worktree its own project slug. The worktree convention is
# <repo>/.claude/worktrees/<name>, so the slug carries this separator and the
# repo name sits before it. Splitting there groups a repo's worktrees together.
ENTRY_FEE_WORKTREE_MARK = "--claude-worktrees-"


# The literal marker that opens the real skill listing sent to the model (inside a
# system-reminder in a user-message content block). Used to MEASURE the actual listing,
# a second, transcript-sourced bucket alongside the disk-sized estimate above.
LISTING_MARKER = "The following skills are available"
# A description this long or longer is worth flagging in the entry-fee report.
LISTING_LONG_DESC_CHARS = 400


def _walk_strings(obj):
    """Yield every string value anywhere in a JSON-like structure, depth-first.

    The marker's home shifted across transcript shapes (an `attachment` field vs. a
    user-message system-reminder block), so this walks every string field rather than
    a fixed path."""
    if isinstance(obj, str):
        yield obj
    elif isinstance(obj, dict):
        for v in obj.values():
            yield from _walk_strings(v)
    elif isinstance(obj, list):
        for v in obj:
            yield from _walk_strings(v)


def _listing_block_text(entry):
    """The first string field of one transcript record that carries LISTING_MARKER,
    sliced from the marker to the end of that field. None if the record has no such field."""
    for s in _walk_strings(entry):
        idx = s.find(LISTING_MARKER)
        if idx != -1:
            return s[idx:]
    return None


def _parse_listing_entries(block_text):
    """Parse `- name: description` lines out of a listing block.

    A line starting with `- ` opens an entry, split on the first `: ` into name and
    description. An indented following line continues the previous entry's description.
    The list ends at the first blank line whose next non-blank line is not a `- ` entry
    (also the end of the block, since the walk stops when lines run out).
    """
    lines = block_text.split("\n")[1:]  # drop the marker/header line itself
    entries = []
    i, n = 0, len(lines)
    while i < n:
        line = lines[i]
        if line.startswith("- "):
            rest = line[2:]
            name, _, desc = rest.partition(": ")
            entries.append([name.strip(), desc.strip()])
            i += 1
        elif line.strip() == "":
            j = i + 1
            while j < n and lines[j].strip() == "":
                j += 1
            if j >= n or not lines[j].startswith("- "):
                break
            i = j
        elif line[:1] in (" ", "\t") and entries:
            entries[-1][1] = (entries[-1][1] + " " + line.strip()).strip()
            i += 1
        else:
            break
    return entries


def measured_listing_session(path):
    """The first record in one transcript that carries the real skill listing -> its
    measured stats, or None (a subagent transcript, or a session with no listing)."""
    for entry in iter_entries(path):
        if not isinstance(entry, dict):
            continue  # malformed transcript line (untrusted input)
        block = _listing_block_text(entry)
        if block is None:
            continue
        parsed = _parse_listing_entries(block)
        chars = len(block)
        ts = entry.get("timestamp")
        return {
            "entries": len(parsed),
            "chars": chars,
            "tokens": chars // ENTRY_FEE_CHARS_PER_TOKEN,
            "over_400": sum(1 for _, d in parsed if len(d) > LISTING_LONG_DESC_CHARS),
            "empty_desc": sum(1 for _, d in parsed if not d),
            "top8": sorted(((name, len(d)) for name, d in parsed), key=lambda t: -t[1])[:8],
            "ts": ts if isinstance(ts, str) else "",
        }
    return None


def listing_collect(args):
    """One row per main session that carries the real skill listing."""
    rows = []
    for path in iter_files(args):
        if os.sep + "subagents" + os.sep in path:
            continue  # a subagent's own transcript, not a session someone started
        s = measured_listing_session(path)
        if s:
            rows.append(s)
    return rows


def listing_median_row(rows):
    """Per-field median across sessions, or None for an empty set."""
    if not rows:
        return None
    return {
        "entries": pctl([r["entries"] for r in rows], 50),
        "chars": pctl([r["chars"] for r in rows], 50),
        "tokens": pctl([r["tokens"] for r in rows], 50),
        "over_400": pctl([r["over_400"] for r in rows], 50),
        "empty_desc": pctl([r["empty_desc"] for r in rows], 50),
    }


def listing_most_recent(rows):
    """The row with the latest timestamp, or None. Rows with no timestamp lose the tie."""
    timed = [r for r in rows if r["ts"]]
    return max(timed, key=lambda r: r["ts"]) if timed else None


def listing_stat_rows(median, recent):
    rows = []
    if median:
        rows.append(["median", median["entries"], median["chars"], median["tokens"], median["over_400"], median["empty_desc"]])
    if recent:
        rows.append(["most-recent", recent["entries"], recent["chars"], recent["tokens"], recent["over_400"], recent["empty_desc"]])
    return rows


def _rendered_chars(entry):
    """Characters of rendered preamble text one attachment entry contributes.

    Every field here is untrusted transcript data, so a non-string content or a
    non-list rendered contributes zero rather than raising: one malformed line
    must not abort the whole scan."""
    r = entry.get("rendered")
    if isinstance(r, str):
        return len(r)
    if not isinstance(r, list):
        return 0
    total = 0
    for b in r:
        c = b.get("content") if isinstance(b, dict) else None
        if isinstance(c, str):
            total += len(c)
    return total


def entry_fee_session(path):
    """One transcript -> its entry fee + component estimate, or None.

    None means the file has no main-chain assistant turn: a subagent's own
    transcript, or a session that never got a reply. Both are excluded rather
    than counted as a zero fee.
    """
    comps = Counter()
    first_ts = None
    for entry in iter_entries(path):
        if not isinstance(entry, dict):
            continue  # malformed transcript line (untrusted input)
        ts = entry.get("timestamp")
        if first_ts is None and isinstance(ts, str):
            first_ts = ts
        if entry.get("type") == "attachment":
            att = entry.get("attachment")
            label = att.get("type") if isinstance(att, dict) else None
            tokens = _rendered_chars(entry) // ENTRY_FEE_CHARS_PER_TOKEN
            if isinstance(label, str) and tokens:
                comps[label] += tokens
            continue
        if entry.get("type") != "assistant" or entry.get("isSidechain"):
            continue
        msg = entry.get("message")
        u = msg.get("usage") if isinstance(msg, dict) else None
        if not isinstance(u, dict):
            continue
        fee = ((u.get("input_tokens") or 0)
               + (u.get("cache_creation_input_tokens") or 0)
               + (u.get("cache_read_input_tokens") or 0))
        # first_ts is the only timestamp already proven to be a string; ts is
        # untrusted and slicing it directly would abort the whole scan.
        return {"fee": fee, "components": comps, "day": (first_ts or "")[:10],
                "model": msg.get("model") or "?"}
    return None


def entry_fee_collect(args):
    """One row per main session, newest-first file order irrelevant."""
    rows = []
    for path in iter_files(args):
        if os.sep + "subagents" + os.sep in path:
            continue  # a subagent's own transcript, not a session someone started
        s = entry_fee_session(path)
        if s:
            s["project"] = os.path.basename(os.path.dirname(path))
            rows.append(s)
    return rows


def entry_fee_median(sessions):
    """The session at the median fee, or None for an empty set."""
    if not sessions:
        return None
    ranked = sorted(sessions, key=lambda s: s["fee"])
    return ranked[_rank_index(len(ranked), 50)]


def entry_fee_split_session(sessions):
    """The session whose component split represents the set.

    Only transcripts that record the rendered preamble can be split at all, so
    the split comes from the median of THOSE sessions rather than the median of
    every session, which would often be one that records nothing and read as a
    100% unattributed fee. Returns (session, how many sessions can be split).

    The breakdown is one real session's, not a per-component median: medians of
    separate components do not add up to the median fee, so a median-of-medians
    table would not reconcile against the measured total.
    """
    splittable = [s for s in sessions if s["components"]]
    return entry_fee_median(splittable), len(splittable)


def entry_fee_component_rows(sess):
    """Component split of one session, biggest first, with the remainder last."""
    if not sess:
        return []
    fee = sess["fee"]
    def share(n):
        return f"{100 * n / fee:.0f}%" if fee else "-"
    rows = [[name, n, share(n)] for name, n in sess["components"].most_common()]
    rest = fee - sum(sess["components"].values())
    # A negative remainder means the 4-chars-per-token estimate overshot the
    # measured fee, which happens on dense markdown and tables. Print that as
    # what it is rather than as a negative measurement: the component shares
    # then read above 100% and say plainly that the estimate broke here.
    if rest < 0:
        rows.append([ENTRY_FEE_OVERSHOT, -rest, "-"])
    else:
        rows.append([ENTRY_FEE_UNATTRIBUTED, rest, share(rest)])
    return rows


def short_project(slug, n=46):
    """Trim a long project slug from the LEFT: the slug is a cwd path with the
    repo name at the end, so the tail is the part worth keeping."""
    return ("..." + slug[-(n - 3):]) if len(slug) > n else slug


def repo_of_slug(slug):
    """A project slug -> the repo it belongs to, folding its worktree slugs in.

    A one-session worktree slug is not a repo, and ranking it against a
    many-session checkout of the same repo reads as a comparison when it is
    the same codebase twice."""
    return slug.split(ENTRY_FEE_WORKTREE_MARK, 1)[0]


def entry_fee_project_rows(sessions, top):
    """Per-repo median fee, largest median first, ties broken by session count.
    The memory index and CLAUDE.md stack differ per checkout, so the per-repo
    figure is the actionable one."""
    by = defaultdict(list)
    for s in sessions:
        by[repo_of_slug(s["project"])].append(s["fee"])
    rows = [[short_project(p), len(v), pctl(v, 50)] for p, v in by.items()]
    rows.sort(key=lambda r: (-r[2], -r[1]))
    return rows[:top] if top else rows


def iso_week(day):
    """`2026-09-08` -> `2026-W37`. Unparseable -> `?`."""
    try:
        y, w, _ = date.fromisoformat(day).isocalendar()
    except ValueError:
        return "?"
    return f"{y}-W{w:02d}"


def entry_fee_week_rows(sessions, top):
    """Weekly median fee, newest week first, so a reduction shows as a drop."""
    by = defaultdict(list)
    for s in sessions:
        by[iso_week(s["day"])].append(s["fee"])
    rows = [[w, len(by[w]), pctl(by[w], 50)] for w in sorted(by, reverse=True)]
    return rows[:top] if top else rows


def run_entry_fee(args):
    """The `entry-fee` view. A separate I/O path from emit(): one row per
    session rather than a model+day aggregation, and never part of `report`."""
    sessions = entry_fee_collect(args)
    med_sess = entry_fee_median(sessions)
    split_sess, splittable = entry_fee_split_session(sessions)
    comp = entry_fee_component_rows(split_sess)
    projects = entry_fee_project_rows(sessions, args.top)
    weeks = entry_fee_week_rows(sessions, args.top) if args.trend else []
    med = med_sess["fee"] if med_sess else 0

    listing_rows = listing_collect(args)
    listing_med = listing_median_row(listing_rows)
    listing_recent = listing_most_recent(listing_rows)

    if args.json:
        print(json.dumps({
            "sessions": len(sessions),
            "median_fee": med,
            "chars_per_token": ENTRY_FEE_CHARS_PER_TOKEN,
            "components_estimated": True,
            "split_sessions": splittable,
            "split_session_fee": split_sess["fee"] if split_sess else 0,
            "split_components": [{"component": r[0], "est_tokens": r[1]} for r in comp],
            "by_project": [{"project": r[0], "sessions": r[1], "median_fee": r[2]} for r in projects],
            "by_week": [{"week": r[0], "sessions": r[1], "median_fee": r[2]} for r in weeks],
            "skill_listing_measured": {
                "sessions": len(listing_rows),
                "median": listing_med,
                "most_recent": {k: v for k, v in listing_recent.items() if k != "top8"} if listing_recent else None,
                "most_recent_top8": [{"skill": n, "chars": c} for n, c in listing_recent["top8"]] if listing_recent else [],
            },
        }, indent=2))
        return

    split_fee = split_sess["fee"] if split_sess else 0
    print(f"# entry-fee  ({len(sessions)} sessions, {len(projects)} projects; median {med} tokens re-read per turn, measured)")
    print(f"  component split of one {split_fee}-token session ({splittable} sessions record the rendered preamble;")
    print(f"  the split is ESTIMATED from disk (component size, e.g. SKILL.md text) at {ENTRY_FEE_CHARS_PER_TOKEN} chars/token,")
    print("  only the totals are measured):")
    print_table(["component", "est-tokens", "share"], comp)
    print("  per repo (median measured fee):")
    print_table(["project", "sessions", "median-fee"], projects)
    if args.trend:
        print("  weekly trend (median measured fee):")
        print_table(["week", "sessions", "median-fee"], weeks)
    print(f"  skill listing MEASURED-FROM-TRANSCRIPT ({len(listing_rows)} sessions carry the real listing;")
    print(f"  chars/token still an estimate at {ENTRY_FEE_CHARS_PER_TOKEN}, entries/chars/over400/empty-desc are exact counts):")
    print_table(["stat", "entries", "chars", "tokens", "over400", "empty-desc"], listing_stat_rows(listing_med, listing_recent))
    if listing_recent:
        print("  most-recent session, top 8 descriptions by length:")
        print_table(["skill", "chars"], [[n, c] for n, c in listing_recent["top8"]])
    print()


def emit(args, data):
    if args.json:
        out = {
            "files": data["files"],
            "skills": [{"skill": k, "count": v, "errors": data["skill_err"].get(k, 0),
                        "count_14d": data["skill_recent"].get(k, 0),
                        "last": (data["skill_last"].get(k) or "")[:10] or None}
                       for k, v in data["skills"].most_common()],
            "skill_latency": [{"skill": r[0], "fires": r[1], "total_ms": r[2], "p50_ms": r[3], "p95_ms": r[4], "max_ms": r[5]} for r in skill_latency_rows(data["skill_durs"], 0)],
            "tools": [{"tool": k, "count": v, "errors": data["tool_err"].get(k, 0)} for k, v in data["tools"].most_common()],
            "hooks": [{"hook": lab, "count": len(v), "p50_ms": pctl(v, 50), "p95_ms": pctl(v, 95), "max_ms": max(v) if v else 0} for lab, v in data["hook_durs"].items()],
            "hook_errors": data["hook_errors"],
            "subagents": {
                "by_day": [{"day": d, "spawns": data["sub_day"][d], "prompts": data["turns_day"].get(d, 0)} for d in sorted(data["sub_day"], reverse=True)],
                "by_type": [{"subagent_type": k, "count": v} for k, v in data["sub_type"].most_common()],
            },
            "friction": {
                "thrash": [{"file": fp, "sessions": data["thrash"][fp], "max_edits": data["thrash_max"].get(fp, 0)} for fp in data["thrash"]],
                "permission": [{"label": k, "events": v} for k, v in data["perm"].most_common()],
                "context_pressure": [{"day": d, "compactions": data["compact_day"][d]} for d in sorted(data["compact_day"], reverse=True)],
                "skill_precision": [{"skill": s, "fires": data["skills"][s], "inert": data["skill_err"][s]} for s in data["skills"] if data["skill_err"].get(s, 0)],
            },
            "sessions": {
                "archetypes": [{"archetype": a, "sessions": data["arch"][a]} for a in data["arch"]],
                "circadian": [{"hour": h, "turns": data["circ"][h][0], "tools": data["circ"][h][1]} for h in sorted(data["circ"])],
                "interruptions": data["interruptions"],
                "interrupt_sessions": data["interrupt_sessions"],
            },
            "cost": {
                "by_model": [{"model": m, "input": t[0], "output": t[1], "cache_read": t[2], "cache_create": t[3], "est_usd": model_cost(m, t)} for m, t in data["tok"].items()],
                "total_est_usd": sum((model_cost(m, t) or 0) for m, t in data["tok"].items()),
                "cache_read": sum(t[2] for t in data["tok"].values()),
                "cache_create": sum(t[3] for t in data["tok"].values()),
            },
        }
        if args.errors:
            msgs = data["tool_err_msg"].get(args.errors, Counter())
            total = sum(msgs.values())
            out["tool_error_groups"] = {
                "tool": args.errors,
                "total": total,
                "groups": [{"prefix": pfx, "count": n,
                            "share": round(100.0 * n / total, 1) if total else 0.0}
                           for pfx, n in msgs.most_common()],
            }
        print(json.dumps(out, indent=2))
        return

    want = args.cmd
    if want in ("skills", "report"):
        print(f"# skills  ({data['files']} transcripts)")
        print_table(["skill", "count", "errors", "rate", "14d", "last"],
                     skill_usage_rows(data["skills"], data["skill_err"], data["skill_last"], data["skill_recent"], args.top))
        print()
        if args.latency:
            print(f"# skill wall-time  (total ms summed per skill, ranked by total; {data['files']} transcripts)")
            print_table(["skill", "fires", "total_ms", "p50ms", "p95ms", "maxms"], skill_latency_rows(data["skill_durs"], args.top))
            print()
    if want in ("tools", "report"):
        if args.errors:
            msgs = data["tool_err_msg"].get(args.errors, Counter())
            total = sum(msgs.values())
            print(f"# tool errors: {args.errors}  ({total} error results across {data['files']} transcripts)")
            rows = [[pfx, str(n), f"{100.0 * n / total:.0f}%"]
                    for pfx, n in msgs.most_common(args.top or None)]
            if rows:
                print_table(["prefix", "count", "share"], rows)
            else:
                print(f"  no error results recorded for {args.errors}")
            print()
        else:
            print(f"# tools  ({data['files']} transcripts)")
            print_table(["tool", "count", "errors", "rate"], usage_rows(data["tools"], data["tool_err"], args.top))
            print()
    if want in ("hooks", "report"):
        print(f"# hooks  ({data['hook_errors']} hook errors across {data['files']} transcripts)")
        print_table(["hook", "runs", "p50ms", "p95ms", "maxms", "sample"], hook_rows(data["hook_durs"], data["hook_sample"], args.top))
        print()
    if want in ("subagents", "report"):
        total_sub = sum(data["sub_type"].values())
        total_prompts = sum(data["turns_day"].values())
        print(f"# subagents  ({total_sub} spawns, {total_prompts} prompts, {data['files']} transcripts)")
        print_table(["day", "spawns", "prompts", "per100"], subagent_day_rows(data["sub_day"], data["turns_day"], args.top))
        print()
        print_table(["subagent_type", "count", "share"], subagent_type_rows(data["sub_type"], args.top))
        print()
    if want in ("friction", "report"):
        print(f"# friction  ({data['files']} transcripts)")
        print(f"  thrash (file edited >= {THRASH_MIN}x in one session):")
        print_table(["file", "sessions", "max-edits"], thrash_rows(data["thrash"], data["thrash_max"], args.top))
        print("  permission-friction (prompts/denials by tool):")
        print_table(["tool/cmd", "events"], perm_rows(data["perm"], args.top))
        print("  context-pressure (compactions per day):")
        print_table(["day", "compactions"], compact_rows(data["compact_day"], args.top))
        print("  skill-precision (skills that mis-fired):")
        print_table(["skill", "fires", "inert", "inert%"], skill_precision_rows(data["skills"], data["skill_err"], args.top))
        print()
    if want in ("sessions", "report"):
        total_turns = sum(data["turns_day"].values())
        ir = f"{100 * data['interruptions'] / total_turns:.1f}" if total_turns else "-"
        print(f"# sessions  ({data['files']} sessions, {data['interrupt_sessions']} interrupted, {data['interruptions']} interrupts = {ir}/100 turns)")
        print("  archetype mix:")
        print_table(["archetype", "sessions", "share"], arch_rows(data["arch"]))
        print("  circadian (UTC hour):")
        print_table(["hour", "turns", "tools"], circ_rows(data["circ"], args.top))
        print()
    if want in ("cost", "report"):
        tok = data["tok"]
        total = sum((model_cost(m, t) or 0) for m, t in tok.items())
        cr = sum(t[2] for t in tok.values())
        cw = sum(t[3] for t in tok.values())
        hit = f"{100 * cr / (cr + cw):.0f}%" if (cr + cw) else "-"
        print(f"# cost  (est ${total:,.2f}, cache-hit {hit}, {data['files']} transcripts; Max-plan flat-rate, this is attribution not a bill)")
        print_table(["model", "input", "output", "cache-rd", "cache-wr", "est$"], cost_rows(tok, args.top))
        print()


def main(argv=None):
    p = argparse.ArgumentParser(prog="session-observe", description="Report Claude Code skill/tool/hook usage from session transcripts.")
    p.add_argument("cmd", choices=["skills", "tools", "hooks", "subagents", "friction", "sessions", "cost", "burn", "entry-fee", "report"], help="which view")
    src = p.add_mutually_exclusive_group()
    src.add_argument("--file", help="parse a single transcript file (used by tests)")
    src.add_argument("--project", help="project slug under ~/.claude/projects/")
    p.add_argument("--root", help=f"transcripts root (default {DEFAULT_ROOT})")
    p.add_argument("--days", type=int, default=0, help="only files modified within N days (0 = all)")
    p.add_argument("--top", type=int, default=0, help="limit to top N rows (0 = all)")
    p.add_argument("--latency", action="store_true", help="(skills) add a per-skill total wall-time table, ranked by summed ms")
    p.add_argument("--errors", metavar="TOOL", help="(tools) group TOOL's error results by message prefix")
    p.add_argument("--since", type=int, default=60, help="(burn only) window in minutes (default 60)")
    p.add_argument("--trend", action="store_true", help="(entry-fee) add a weekly median table, newest week first")
    p.add_argument("--json", action="store_true", help="machine-readable output (for vps-mon ingest)")
    args = p.parse_args(argv)

    if args.errors and args.cmd != "tools":
        p.error("--errors only applies to the tools view")

    if args.file and not os.path.exists(args.file):
        print(f"session-observe: file not found: {args.file}", file=sys.stderr)
        return 1

    if args.cmd == "burn":
        run_burn(args)
        return 0

    if args.cmd == "entry-fee":
        run_entry_fee(args)
        return 0

    data = collect(args)
    emit(args, data)
    return 0


if __name__ == "__main__":
    sys.exit(main())
