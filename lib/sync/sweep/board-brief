#!/usr/bin/env python3
"""board brief: ONE message per cluster per day, built on `board health`.

The brief tells the operator what needs a decision, then what is broken, then
(on a slower clock) how the boards look, then one line of what the bots did.
Everything else goes to a details message that follows. Instant alerts stay on
their own rails; the brief never replaces them.

Message order, each section omitted when empty, each under a Discord small heading
(`### ...`) and separated from the next by a blank line:

  Needs your decision   one bullet per item, the closing question in bold: hub rows whose
                        state differs from their Hermes mirror card in a way the mirror
                        cannot settle (`ID hub/mirror drift: ... **Ship or reopen?**`), and
                        incident rows the --incidents hook marks `needs_you`, and a linked
                        Hermes profile whose kit skills are stale (`kit skills on <label>
                        are stale: re-run board hermes link`, from `board hermes check`).
                        Three at most, then `+N more in details`. With none and no fault,
                        the heading `Nothing needs you` stands alone.
  Open incidents        from the --incidents hook (see below): the count, up to three rows,
                        the hook's own fault lines
  Boards                the `board health` lines (hub, board, fault, extra). Shown only when
                        a decision item exists or --boards-every-days (default 3) has passed
                        since they last posted; otherwise they ride the details message.
  Sync / Bots           one heading: the sync lines (with the boards), then one count line:
                        the hook's bot counts, cards archived since the last delivered
                        brief, and sync errors. Sync failures do not bring the boards back:
                        the bots line counts them, and instant alerts stay on their own rails.

Ids are links, never plain text: a board row id is a masked link to its line in the GitHub
copy of the board (`[ID-538](<https://github.com/OWNER/REPO/blob/BRANCH/FILE?plain=1#L183>)`,
read from the repo's origin remote and `git grep` on the origin ref), a hook row or decision
with a `url` is a masked link to it. Every link has its URL in angle brackets, so Discord shows
no preview. An id with no URL (the repo is not on GitHub, the hook gave none) is inline code.
A host after `@` is inline code. A hook URL must be https and free of markup characters.

Incident hook (--incidents C=CMD): CMD prints one JSON object on stdout, so any
operator's incident source fits. Every key is optional:

  {"open":    [{"id","label","host","url","age","firing":bool,"needs_you":bool,"question"}],
   "decisions": [{"id","url","question"}],  explicit decision lines
   "bots":    {"auto-resolved": 3},      counts of what bots did, shown as given
   "faults":  ["line", ...],             fault lines for the incidents section
   "details": ["line", ...]}             extra lines for the details message

A hook that fails, or prints something that is not that object, becomes a fault
line: the brief never claims "all clear" over an unreadable feed. Under --dry-run
and --no-state the hook runs with BOARD_BRIEF_READ_ONLY=1 in its environment and
must write nothing (no alert, no heartbeat).

The payload (one JSON line per cluster, stdout under --dry-run), handed to
--poster on stdin; exit 0 means the main message was delivered:
  {kind: "brief", cluster, rail, key, severity: info|warn, title, date,
   period_days: 1, next_due, attention: bool (a decision item exists),
   fields: [{name, value}]  the main message, one line per field
   details: [line, ...]     the follow-up message, absent when empty
   carried_error?, data: {...}}
The poster delivers the details as a second message (a thread reply where the
rail supports one). A failed details post never fails the main post.

Flags (the source flags are `board health run`'s: --registry --cluster-map
--state-file --health-state-file --stale-days --sync-stale-hours --kanban --line
--hub --board --triage-open --triage-days):
  --config F            flags from a JSON file, see `board health run`; the
                        section name is `brief`
  --incidents C=CMD     incident hook for cluster C (repeatable)
  --decisions-only C    cluster C posts only when a decision item exists, and the
                        message is the decision lines alone
  --every-days N        cadence (default 1); a failed post is not stamped, so it
                        stays due and rides `carried_error`
  --boards-every-days N how often the boards section shows without a reason (default 3)
  --show-boards         always show the boards section (a preview)
  --main-chars N        budget for the main message (default 1250, under the poster's 1380
                        cap with its footer): over it, the boards block moves to the details,
                        then the incident rows past the first
  --poster CMD          delivers one payload on stdin
  --cluster C           only this cluster
  --force               ignore the cadence
  --dry-run             print payloads, post nothing, write nothing
  --no-state            post for real but write no stamp or baseline (a live test)
  --now EPOCH           pin the clock (tests)

State lives in the health state file under `brief`, beside the sweep's records.
stderr: `brief: ...` log lines. Exit 0 on a normal run; only a usage error is nonzero.
"""

import argparse
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent


sys.path.insert(0, str(HERE))
import sweep_modules  # noqa: E402

H = sweep_modules.load("board-health")
HM = sweep_modules.load("board-hermes")
DAY = H.DAY
ORIGIN_ID_RE = re.compile(r"^origin:\s*([^\s:]+):(\S+)", re.M)
TERMINAL_ROW = ("shipped", "dropped", "done", "closed")
MAX_DECISIONS = 3
MAX_INCIDENTS = 3


def log(msg):
    print(f"brief: {msg}", file=sys.stderr)


# --- the incident hook ---------------------------------------------------------

def _text(value, cap=200):
    """One printable line from a hook value. Secrets are masked (webhook URLs, secret
    references, long hex or base64 runs); a name like `some_rule-crit` is kept whole.
    Markup characters are dropped so a hook value cannot forge a link or a code span."""
    if value is None:
        return ""
    text = "".join(c if c.isprintable() else " " for c in str(value))
    text = re.sub(r"[`<>\[\]*]", "", text)
    text = re.sub(r"https://discord(app)?\.com/api/webhooks/\S+", "[webhook-redacted]", text)
    text = re.sub(r"op://\S+", "[ref-redacted]", text)
    text = re.sub(r"\b[0-9a-fA-F]{32,}\b|\b[A-Za-z0-9+/=]{40,}\b", "[redacted]", text)
    return re.sub(r"\s+", " ", text).strip()[:cap]


URL_RE = re.compile(r"^https://[^\s<>()\[\]`]{1,300}$")


def _url(value):
    """A hook URL: https only, no markup characters, no webhook; else empty."""
    v = str(value or "").strip()
    return v if URL_RE.match(v) and "/api/webhooks/" not in v else ""


def link(text, url):
    """A masked link with the preview suppressed, or the text in inline code when there is no URL."""
    return f"[{text}](<{url}>)" if url else f"`{text}`"


def bold_question(text):
    """The closing question of a decision line in bold: `... Ship or reopen?` becomes `... **Ship or reopen?**`."""
    m = re.search(r"([^.!?:]*\?)\s*$", text)
    if not m or not m.group(1).strip():
        return text
    q = m.group(1)
    return text[:m.start(1)] + q[:len(q) - len(q.lstrip())] + "**" + q.strip() + "**"


def code_host(label):
    """`rule @ host` with the host in inline code."""
    return re.sub(r" @ (\S+)", lambda m: f" @ `{m.group(1)}`", label)


def read_incidents(cmd, read_only=False):
    """(data, error): the hook's JSON object, cleaned; error is one short reason.
    Under a preview or a live test the hook runs with BOARD_BRIEF_READ_ONLY=1 and
    must write nothing."""
    env = dict(os.environ, BOARD_BRIEF_READ_ONLY="1") if read_only else None
    try:
        r = subprocess.run(shlex.split(cmd), capture_output=True, text=True, timeout=300, env=env)
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, H.redact(str(e), 100)
    if r.returncode != 0:
        return None, H.redact(r.stderr or f"exit {r.returncode}", 100)
    try:
        raw = json.loads(r.stdout)
    except ValueError:
        return None, "hook printed no JSON"
    if not isinstance(raw, dict):
        return None, "hook JSON is not an object"
    rows = []
    for o in raw.get("open") or []:
        if isinstance(o, dict):
            rows.append({"id": _text(o.get("id"), 40), "label": _text(o.get("label"), 120),
                         "host": _text(o.get("host"), 60), "url": _url(o.get("url")),
                         "age": _text(o.get("age"), 20), "firing": bool(o.get("firing")),
                         "needs_you": bool(o.get("needs_you")), "question": _text(o.get("question"), 160)})
    decisions = [{"id": _text(d.get("id"), 40), "url": _url(d.get("url")), "question": _text(d.get("question"), 200)}
                 for d in raw.get("decisions") or [] if isinstance(d, dict) and d.get("question")]
    bots = {str(k)[:40]: v for k, v in (raw.get("bots") or {}).items()
            if isinstance(v, int) and not isinstance(v, bool) and v >= 0} if isinstance(raw.get("bots"), dict) else {}
    return {"open": rows, "decisions": decisions, "bots": bots,
            "faults": [_text(x, 240) for x in raw.get("faults") or [] if x],
            "details": [_text(x, 300) for x in raw.get("details") or [] if x]}, None


def what_of(o):
    """The row's label with its host in inline code (a label that already holds ` @ host` is handled too)."""
    label = code_host(o["label"])
    return label + (f" @ `{o['host']}`" if o["host"] else "")


def incident_line(o):
    ident = link(o["id"], o["url"]) if o["id"] else ""
    parts = [p for p in (o["age"], ident, what_of(o)) if p]
    return " ".join(parts) + (" · firing" if o["firing"] else "")


# --- ids as links ------------------------------------------------------------------------

_repo_info = {}


def repo_info(path):
    """(owner/repo, branch, relative path) for a board file kept on GitHub, else None."""
    if path in _repo_info:
        return _repo_info[path]
    info = None
    p = Path(path)
    top = H.git(p.parent, "rev-parse", "--show-toplevel")
    if p.is_file() and top.returncode == 0 and top.stdout.strip():
        root = top.stdout.strip()
        remote = H.git(root, "remote", "get-url", "origin").stdout.strip()
        m = re.search(r"github\.com[:/]+([^/\s]+)/([^/\s]+?)(?:\.git)?$", remote)
        ref = H.origin_ref(root)
        if m and ref:
            rel = os.path.relpath(os.path.realpath(p), os.path.realpath(root))
            info = (f"{m.group(1)}/{m.group(2)}", ref.split("/", 1)[1], rel, root, ref)
    _repo_info[path] = info
    return info


def row_link(path, rid):
    """A board row id as a masked link to its line in the GitHub copy of the board, else inline code."""
    info = repo_info(path)
    if not info:
        return f"`{rid}`"
    slug, branch, rel, root, ref = info
    r = H.git(root, "grep", "-n", "-E", rf"^\| {re.escape(rid)} \|", ref, "--", rel)
    m = re.search(r":(\d+):", r.stdout.splitlines()[0]) if r.returncode == 0 and r.stdout.strip() else None
    if not m:
        return f"`{rid}`"
    return link(rid, f"https://github.com/{slug}/blob/{branch}/{rel}?plain=1#L{m.group(1)}")


# --- hub/mirror drift ------------------------------------------------------------

def mirror_drift(reader, hub_name, hub_path):
    """Rows whose hub state and mirror card disagree in a way the mirror cannot
    settle by itself: the board says finished and the card is open, or the card is
    done and the board still says live. [{id, board, card, what}], sorted by id."""
    rows = H.hub_rows(hub_path)
    if rows is None:
        return []
    try:
        cards = H.kanban_json(reader, ["--board", hub_name, "list", "--json"])
    except (H.KanbanError, OSError, subprocess.TimeoutExpired):
        return []
    status_of = {}
    for c in cards:
        m = ORIGIN_ID_RE.search(c.get("body") or "")
        if m and m.group(1) == hub_name:
            status_of[m.group(2)] = c.get("status")
    out = []
    for rid, card in sorted(status_of.items()):
        row = rows.get(rid)
        if not row or not row[0]:
            continue
        board = row[0]
        card_open = card not in ("done", "archived")
        board_done = board in TERMINAL_ROW
        if card_open and board_done:
            what = f"board says {board}, the Hermes card is still open"
        elif not card_open and not board_done:
            what = f"the Hermes card is done, the board says {board}"
        else:
            continue
        out.append({"id": rid, "board": board, "card": card, "what": what})
    return out


# --- one cluster's brief -----------------------------------------------------------

def compose(cluster, rail, args, rows, health, digest, bstate, now):
    last_run = bstate.get("last_run", {})
    prev_archived = bstate.get("archived", {}).get(cluster, {})
    hview = {k: v for k, v in health.items() if k != "errors"}
    hp, kanban = H.build_payload(cluster, rail, args, rows, hview, digest, last_run, prev_archived, now)

    archived_total = sum((hp["data"].get("archived_since") or {}).values())
    sync_errors = sum(1 for f in hp["fields"] if f["name"] == "attention" and f["value"].startswith("❌"))

    paths = {r["name"]: r["path"] for r in rows}

    # decisions: each line carries its id as a link and its question in bold
    decisions = []
    hub_name = (args.hub_map.get(cluster) or [None])[0]
    reader = (args.kanban_map.get(cluster) or [None])[0]
    drift = []
    if hub_name and reader and hub_name in paths:
        drift = mirror_drift(reader, hub_name, paths[hub_name])
    for d in drift:
        decisions.append(f"{row_link(paths[hub_name], d['id'])} hub/mirror drift: {d['what']}. **Ship or reopen?**")

    inc, inc_err = None, None
    hook = (args.incident_map.get(cluster) or [None])[0]
    if hook:
        inc, inc_err = read_incidents(hook, args.dry_run or args.no_state)
    open_rows = inc["open"] if inc else []
    for o in open_rows:
        if o["needs_you"]:
            ident = link(o["id"], o["url"]) if o["id"] else ""
            decisions.append(f"{ident} {what_of(o)}: {bold_question(o['question'] or 'Act or close?')}".strip())
    for d in (inc["decisions"] if inc else []):
        ident = link(d["id"], d["url"]) if d["id"] else ""
        decisions.append(f"{ident} {bold_question(d['question'])}".strip())

    # a Hermes profile linked to this kit whose skills are out of date: the sweep records
    # the comparison each tick, and a brief with no record compares now
    links = health.get("hermes_links")
    if links is None:
        links = HM.check_links()
    for lk in links:
        if lk.get("stale") and (lk.get("cluster") or args.first_cluster) == cluster:
            decisions.append(f"kit skills on `{lk.get('label') or lk.get('profile')}` are stale: re-run `board hermes link`")

    only = cluster in set(args.decisions_only or [])
    feed_faults = ([f"⚠️ incident feed unreadable: {inc_err}"] if inc_err else []) + (inc["faults"] if inc else [])

    # health lines, grouped: boards, then sync; an id in a flapping line becomes a link
    def linkify(line):
        m = re.match(r"^(⚠️ )([A-Z]+-[0-9]+)( flapping between the board and a spoke \()([^)]+)(\))$", line)
        if m and m.group(4) in paths:
            return m.group(1) + row_link(paths[m.group(4)], m.group(2)) + m.group(3) + m.group(4) + m.group(5)
        return line

    boards_lines = [f["value"] for f in hp["fields"] if f["name"] in ("hub", "board", "fault", "extra")]
    sync_lines = [linkify(f["value"]) for f in hp["fields"] if f["name"] in ("sync", "attention")]
    bots = [f"{k} {v}" for k, v in (inc["bots"].items() if inc else []) if v]
    if archived_total:
        bots.append(f"archived {archived_total}")
    bots.append(f"sync errors {sync_errors}")

    boards_last = bstate.get("boards_last", {}).get(cluster)
    slow_clock = boards_last is None or now - boards_last >= args.boards_every_days * DAY - 1800
    show_boards = bool(not only and (args.show_boards or decisions or slow_clock))

    # blocks of the main message in priority order; a block is (name, heading, lines)
    main = []
    more = []   # blocks that ride the details message
    if decisions:
        main.append(["decision", f"### 🙋 Needs your decision ({len(decisions)})", [f"• {d}" for d in decisions[:MAX_DECISIONS]]])
        if len(decisions) > MAX_DECISIONS:
            main[-1][2].append(f"+{len(decisions) - MAX_DECISIONS} more in details")
            more.append(["decision", "### 🙋 More decisions", [f"• {d}" for d in decisions[MAX_DECISIONS:]]])
    elif not only and not feed_faults:
        main.append(["clear", "### ✅ Nothing needs you", []])
    if not only:
        inc_lines = [f"• {incident_line(o)}" for o in open_rows[:MAX_INCIDENTS]]
        if len(open_rows) > MAX_INCIDENTS:
            inc_lines.append(f"+{len(open_rows) - MAX_INCIDENTS} more in details")
            more.append(["incident", "### 🔥 More incidents", [f"• {incident_line(o)}" for o in open_rows[MAX_INCIDENTS:]]])
        inc_lines += [ln if ln.startswith(("⚠️", "⛔", "❌")) else f"⚠️ {ln}" for ln in feed_faults]
        if open_rows:
            main.append(["incident", f"### 🔥 Open incidents ({len(open_rows)})", inc_lines])
        elif inc_lines:
            main.append(["incident", "### 🔥 Incident feed", inc_lines])
        if boards_lines:
            (main if show_boards else more).append(["board", "### 🗂️ Boards", boards_lines])
        bots_line = "🤖 24h: " + " · ".join(bots)
        if show_boards and sync_lines:
            main.append(["bots", "### 🔄 Sync · 🤖 Bots", sync_lines + [bots_line]])
        else:
            if sync_lines:
                more.append(["sync", "### 🔄 Sync", sync_lines])
            main.append(["bots", "### 🤖 Bots", [bots_line]])
        extra = (inc["details"] if inc else []) + ([f"🧹 archived since the last brief: {archived_total}"] if archived_total else [])
        if extra:
            more.append(["more", "### ℹ️ More", extra])

    # keep the main message under the poster's cap: the boards block goes to the details first, then
    # the incident rows past the first
    def size(blocks):
        return sum(len(h) + 1 + sum(len(x) + 1 for x in ls) + 1 for _, h, ls in blocks)

    if size(main) > args.main_chars:
        board_blk = next((b for b in main if b[0] == "board"), None)
        if board_blk:
            main.remove(board_blk)
            more.append(board_blk)
            show_boards = False
    if size(main) > args.main_chars:
        inc_blk = next((b for b in main if b[0] == "incident" and len(b[2]) > 2), None)
        if inc_blk:
            kept, rest = inc_blk[2][:1], [x for x in inc_blk[2][1:] if x.startswith("• ")]
            if rest:
                inc_blk[2] = kept + [f"+{len(rest)} more in details"]
                more.append(["incident", "### 🔥 More incidents", rest])

    def render(blocks):
        out = []
        for name, head, ls in blocks:
            if out:
                out.append(("gap", ""))
            out.append((f"{name}-head", head))
            out += [(name, x) for x in ls]
        return out

    fields = [{"name": n, "value": v} for n, v in render(main)]
    details = [v for _, v in render(more)]

    day = H.day_stamp(now)
    key = hashlib.sha256(f"brief|{cluster}|{day}".encode()).hexdigest()[:32]
    payload = {
        "kind": "brief", "cluster": cluster, "rail": rail, "key": key,
        "severity": "warn" if decisions else "info",
        "title": f"Daily brief · {cluster}", "date": day, "period_days": 1,
        "next_due": H.day_stamp(now + DAY), "attention": bool(decisions),
        "fields": fields,
        "data": {"decisions": decisions, "drift": [d["id"] for d in drift], "open_incidents": len(open_rows),
                 "boards_shown": show_boards, "archived": archived_total, "sync_errors": sync_errors,
                 "bots": inc["bots"] if inc else {}},
    }
    if details:
        payload["details"] = details
    carried = bstate.get("errors", {}).get(cluster)
    if carried:
        payload["carried_error"] = carried
        payload["fields"].append({"name": "retry", "value": "↻ retry: carried forward after a failed post"})
    return payload, kanban, show_boards


# --- run -----------------------------------------------------------------------------

def cmd_run(args):
    now = int(args.now or time.time())
    rows = H.parse_registry(args.registry)
    if not rows:
        print("board brief run: empty or missing --registry", file=sys.stderr)
        return 64
    H.prepare_run_args(args)
    args.incident_map = H.per_cluster_flags(args.incidents)
    args.faults_only = []
    write = not (args.dry_run or args.no_state)
    health = H.read_json(args.health_state_file, {})
    digest = H.read_json(args.state_file, {})
    bstate = health.get("brief", {})

    clusters = H.clusters_of(rows, args.cluster_map)
    args.first_cluster = clusters[0][0] if clusters else ""
    for cluster, rail in clusters:
        if args.cluster and cluster != args.cluster:
            continue
        if not H.is_due(cluster, bstate.get("last_run", {}), args, now):
            nxt = H.day_stamp(bstate["last_run"][cluster] + args.every_days * DAY)
            log(f"skipped(not-due) {cluster} next={nxt}")
            continue
        payload, kanban, boards_shown = compose(cluster, rail, args, rows, health, digest, bstate, now)
        baseline = {s: b["archived_total"] for s, b in kanban.items()}

        def stamp(error=None):
            if not write:
                return
            st = H.read_json(args.health_state_file, {})
            b = st.setdefault("brief", {})
            for k in ("last_run", "archived", "boards_last", "errors"):
                b.setdefault(k, {})
            if error is None:
                b["last_run"][cluster] = now
                if baseline:
                    b["archived"][cluster] = baseline
                if boards_shown:
                    b["boards_last"][cluster] = now
                b["errors"].pop(cluster, None)
            else:
                b["errors"][cluster] = error
            H.write_state(args.health_state_file, st)

        only = cluster in set(args.decisions_only or [])
        if only and not payload["attention"]:
            log(f"skipped(no-decision) {cluster}")
            stamp()
            continue
        line = json.dumps(payload, ensure_ascii=False, separators=(",", ":"))
        if args.dry_run:
            print(line)
            log(f"{cluster} dry-run (not posted)")
            continue
        if not args.poster:
            print("board brief run: need --poster (or --dry-run)", file=sys.stderr)
            return 64
        try:
            r = subprocess.run(shlex.split(args.poster), input=line, capture_output=True, text=True, timeout=180)
            ok, detail = r.returncode == 0, (r.stderr or "").strip()[-400:] or f"poster exit {r.returncode}"
        except (OSError, subprocess.TimeoutExpired) as e:
            ok, detail = False, str(e)
        if ok:
            stamp()
            log(f"{cluster} posted key={payload['key']}")
        else:
            reason = H.redact(detail, 400)
            stamp(reason)
            log(f"ERROR({reason}) {cluster}")
    return 0


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    ap = argparse.ArgumentParser(prog="board brief", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="mode", required=True)
    p = sub.add_parser("run")
    p.add_argument("--config")
    p.add_argument("--health-state-file", default=H.DEFAULT_HEALTH_STATE)
    p.add_argument("--now", type=int)
    H.add_source_flags(p)
    p.add_argument("--incidents", action="append")
    p.add_argument("--decisions-only", action="append")
    p.add_argument("--every-days", type=float, default=1)
    p.add_argument("--boards-every-days", type=float, default=3)
    p.add_argument("--show-boards", action="store_true")
    p.add_argument("--main-chars", type=int, default=1250)
    p.add_argument("--poster")
    p.add_argument("--cluster")
    p.add_argument("--force", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--no-state", action="store_true")
    if argv and argv[0] == "run":
        argv = ["run"] + H.expand_config(argv[1:], "brief")
    args = ap.parse_args(argv)
    return cmd_run(args)


if __name__ == "__main__":
    sys.exit(main())
