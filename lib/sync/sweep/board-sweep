#!/bin/bash
# board-sweep: one scheduled sweep over every board in a registry, instead of
# one `board sync` plist per repo.
#
# Per repo (registry order, then any --extra-board):
#   1. `board sync` for the repo's own [sync] config (a repo without one is a skip)
#   2. the change-only digest parse of that sync's output (when --poster is set)
#   3. `board publish`, only when the sync itself wrote the board
# After the loop:
#   4. the after-sync legs the installed adapters declare (a mirror of the boards
#      onto another store, an expiry pass), each a child script; see lib/adapters/README.md
#   5. one digest post per cluster, through the --poster command
#   6. the health leg (only with --health): one health digest per cluster on a
#      slow clock, through the same poster (see board-health)
#   7. the last legs the adapters declare (a link check, say)
#   8. the --on-clean hook, only when every leg above came back clean
#
# The registry is the one `board all` renders from: `<name> <path-to-BACKLOG.md>
# [bridge] [rail=<rail>]`. Each repo's own .kit.toml decides whether it syncs at
# all; a repo with no [sync] block is refused by `board sync` and logs a skip.
#
# What the kit does NOT know: which chat service the digest goes to, how the
# host authenticates, or which checkouts are kept fresh. Those arrive as hooks:
#   --preflight CMD   run once before the loop as `CMD <registry>`; a nonzero
#                     exit marks the sweep failed, so the on-clean hook is held
#   --poster CMD      delivers one digest payload (see board-sweep-post.sh)
#   --on-clean CMD    run when the sweep ends clean (a liveness ping, say)
#
# Usage: board sweep --registry F [options]
#   --name LABEL            label in the start/end log lines (default board-sweep)
#   --board-cmd CMD         the board entrypoint to call (default: this kit's bin/board)
#   --extra-board PATH      one more BACKLOG.md to sweep after the registry (repeatable)
#   --repo-arg NAME=ARG     one extra argv item for NAME's `board sync` (repeatable,
#                           split on the first `=`, so a filter is two --repo-arg flags)
#   --sync-token-repo NAME  NAME's `board sync` receives GH_TOKEN (repeatable)
#   --preflight CMD | --poster CMD | --on-clean CMD     the hooks above
#   --cluster-map M         `cluster=rail,cluster=rail` for the digest (see board-digest.sh)
#   --crit-prefix P         adopted rows titled P... make a digest `crit`
#   --field-cap N           digest field cap
#   --state-file F          digest state (default: digest-state.json in `config data path state backlog-sync`)
#   --repo-root D           repo root handed to the legs (default: the cwd's git root)
#   --health                add the health leg: `board-health run` after the digests, due
#                           every --health-every-days (default 3) per cluster. Without it the
#                           sweep only RECORDS each leg's outcome, so a later `board health`
#                           has data. The poster gets the payload with `"kind":"health"`.
#   --health-every-days N | --health-stale-days N | --health-force
#   --health-kanban C=CMD   kanban reader for cluster C (a kanban wrapper command; repeatable)
#   --health-line C=CMD     extra digest lines for cluster C, one per stdout line (repeatable)
#   --health-quiet C        post nothing for cluster C while it is clean (repeatable)
#   --health-hub C=NAME | --health-board C=SLUG | --health-faults-only C
#   --health-triage-open N | --health-triage-days N     which lines a cluster shows (see board-health)
#   --health-state-file F   health state (default: health-state.json in `config data path state backlog-sync`)
#   --dry-run               plan only: `board sync --dry-run`, no publish, the legs told it is a
#                           dry run (SWEEP_DRY_RUN=1), digests printed instead of posted, the real
#                           digest state untouched (health state too), no on-clean hook
#
# The legs and their flags come from the adapters in lib/adapters/*/adapter.tsv (sweep-opt and leg
# rows); `--help` lists those flags after this text. A leg runs as a child of this script under
# its own interpreter, with the SWEEP_* variables and its sweep-opt values in its environment; the
# sweep token never reaches it.
#
# The one credential handoff is the BOARD_SWEEP_TOKEN env var: a GitHub token the
# operator resolved. It is read once, removed from the environment, and passed
# per call to exactly two legs (the --sync-token-repo syncs, and every publish,
# through a GIT_ASKPASS helper so it never rides argv). Arbitrary spoke plugins
# never see it.
#
# Exit: 0 clean, 1 when any sync, publish, or preflight leg failed, or when a leg's script is
# missing (a broken install, found when the leg runs, after the per-repo syncs). The digest and
# the adapter legs are observational: they log, they never flip the exit code. INT or TERM during
# a leg stops the leg, waits for it, and ends the sweep at once with 130 or 143: no later leg, no
# digest post, no health leg, no on-clean hook.
set -u

# launchd hands a bare PATH (/usr/bin:/bin:...); board sync shells out to op,
# python3, gh and ntn, so widen it exactly as board-sync-cron does.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

BIN="$(cd "$(dirname "$0")" && pwd)"
KIT_DIR="$(cd "$BIN/../../.." && pwd)"

NAME="board-sweep"
BOARDS=""
BOARD_CMD="$KIT_DIR/bin/board"
EXTRA_BOARDS=()
REPO_ARGS=()
SYNC_TOKEN_REPOS=()
PREFLIGHT=""
POSTER=""
ON_CLEAN=""
SYNC_STATE_DIR="$(bash "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../../config/data-path.sh" path state backlog-sync)"
STATE_FILE="$SYNC_STATE_DIR/digest-state.json"
REPO_ROOT=""
DRY_RUN=0
digest_flags=()
HEALTH=0
HEALTH_STATE="$SYNC_STATE_DIR/health-state.json"
health_flags=()
HEALTH_MAP=""

# The adapters' sweep flags and legs, read once from their manifests. A sweep-opt row gives a flag
# (--FLAG VALUE) whose value reaches the legs as ENV; a leg row gives a script run as a child.
SWEEPOPT_FLAG=(); SWEEPOPT_ENV=(); SWEEPOPT_VAL=(); SWEEPOPT_HELP=()
LEG_PHASE=(); LEG_NAME=(); LEG_PATH=()
ADAPTER_ROWS_BAD=0

load_adapter_rows() {
  local rows adir a b c
  rows="$(adapters_rows sweep-opt)" || return 1
  while IFS=$'\t' read -r adir a b c; do
    [ -n "$adir" ] || continue
    SWEEPOPT_FLAG+=("$a"); SWEEPOPT_ENV+=("$b"); SWEEPOPT_VAL+=(""); SWEEPOPT_HELP+=("$c")
  done <<< "$rows"
  rows="$(adapters_rows leg)" || return 1
  while IFS=$'\t' read -r adir a b; do
    [ -n "$adir" ] || continue
    LEG_PHASE+=("$a"); LEG_PATH+=("$adir/$b"); b="${b##*/}"; LEG_NAME+=("${b%.*}")
  done <<< "$rows"
}

sweepopt_set() {  # <arg> <value>: 0 when <arg> is an adapter's sweep flag, with its value stored
  local i=0
  while [ "$i" -lt "${#SWEEPOPT_FLAG[@]}" ]; do
    if [ "--${SWEEPOPT_FLAG[$i]}" = "$1" ]; then SWEEPOPT_VAL[$i]="${2:-}"; return 0; fi
    i=$((i + 1))
  done
  return 1
}

# A reader that quits at the first match (`--help | grep -q`) closes the pipe early; that is not an error.
usage() {
  local i=0 text
  text="$(sed -n '2,/^set -u/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//')"
  if [ "${#SWEEPOPT_FLAG[@]}" -gt 0 ]; then
    text="$text"$'\n\nAdapter flags (lib/adapters/*/adapter.tsv):'
    while [ "$i" -lt "${#SWEEPOPT_FLAG[@]}" ]; do
      text="$text"$'\n'"  --${SWEEPOPT_FLAG[$i]} VALUE  ${SWEEPOPT_HELP[$i]}"
      i=$((i + 1))
    done
  fi
  trap '' PIPE
  printf '%s\n' "$text" 2>/dev/null
  return 0
}

. "$BIN/../adapters.sh"
load_adapter_rows || ADAPTER_ROWS_BAD=1

while [ $# -gt 0 ]; do case "$1" in
  --registry) BOARDS="${2:-}"; shift 2;;
  --name) NAME="${2:-}"; shift 2;;
  --board-cmd) BOARD_CMD="${2:-}"; shift 2;;
  --extra-board) EXTRA_BOARDS+=("${2:-}"); shift 2;;
  --repo-arg) REPO_ARGS+=("${2:-}"); shift 2;;
  --sync-token-repo) SYNC_TOKEN_REPOS+=("${2:-}"); shift 2;;
  --preflight) PREFLIGHT="${2:-}"; shift 2;;
  --poster) POSTER="${2:-}"; shift 2;;
  --on-clean) ON_CLEAN="${2:-}"; shift 2;;
  --cluster-map) HEALTH_MAP="${2:-}"; digest_flags+=("$1" "${2:-}"); shift 2;;
  --crit-prefix|--field-cap) digest_flags+=("$1" "${2:-}"); shift 2;;
  --health) HEALTH=1; shift;;
  --health-force) health_flags+=(--force); shift;;
  --health-every-days) health_flags+=(--every-days "${2:-}"); shift 2;;
  --health-stale-days) health_flags+=(--stale-days "${2:-}"); shift 2;;
  --health-kanban) health_flags+=(--kanban "${2:-}"); shift 2;;
  --health-line) health_flags+=(--line "${2:-}"); shift 2;;
  --health-quiet) health_flags+=(--quiet "${2:-}"); shift 2;;
  --health-hub) health_flags+=(--hub "${2:-}"); shift 2;;
  --health-board) health_flags+=(--board "${2:-}"); shift 2;;
  --health-faults-only) health_flags+=(--faults-only "${2:-}"); shift 2;;
  --health-triage-open) health_flags+=(--triage-open "${2:-}"); shift 2;;
  --health-triage-days) health_flags+=(--triage-days "${2:-}"); shift 2;;
  --health-state-file) HEALTH_STATE="${2:-}"; shift 2;;
  --state-file) STATE_FILE="${2:-}"; shift 2;;
  --repo-root) REPO_ROOT="${2:-}"; shift 2;;
  --dry-run) DRY_RUN=1; shift;;
  -h|--help) usage; exit 0;;
  *) if sweepopt_set "$1" "${2:-}"; then shift; [ $# -eq 0 ] || shift
     else echo "board sweep: unknown arg: $1 (adapter dir: $(adapters_dir 2>/dev/null))" >&2; exit 64; fi;;
esac; done
[ "$ADAPTER_ROWS_BAD" -eq 0 ] || exit 1

[ -n "$BOARDS" ] || { echo "board sweep: need --registry <file>" >&2; exit 64; }
[ -f "$BOARDS" ] || { echo "board sweep: no registry at $BOARDS" >&2; exit 2; }
[ -n "$REPO_ROOT" ] || REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# The token is captured and dropped from the environment before any child runs.
SWEEP_TOKEN="${BOARD_SWEEP_TOKEN:-}"
unset BOARD_SWEEP_TOKEN

DIGEST="$BIN/board-digest.sh"
POST="$BIN/board-sweep-post.sh"
GIT_ASKPASS_HELPER="$BIN/board-git-askpass"
HEALTH_BIN="$BIN/board-health"

# A dry run reads the real digest state but writes a scratch copy, so planned
# lines never reach flap tracking or the carried-forward set.
if [ "$DRY_RUN" -eq 1 ]; then
  DRY_STATE="$(mktemp "${TMPDIR:-/tmp}/board-sweep-state.XXXXXX")"
  [ -f "$STATE_FILE" ] && cp "$STATE_FILE" "$DRY_STATE"
  STATE_FILE="$DRY_STATE"
  DRY_HEALTH_STATE="$(mktemp "${TMPDIR:-/tmp}/board-sweep-health.XXXXXX")"
  [ -f "$HEALTH_STATE" ] && cp "$HEALTH_STATE" "$DRY_HEALTH_STATE"
  HEALTH_STATE="$DRY_HEALTH_STATE"
fi
digest_common=(--registry "$BOARDS" --state-file "$STATE_FILE" ${digest_flags[@]+"${digest_flags[@]}"})

ts() { date '+%Y-%m-%d %H:%M:%S'; }
echo "[$(ts)] $NAME: start"

rc_any=0

if [ -n "$PREFLIGHT" ]; then
  "$PREFLIGHT" "$BOARDS" || rc_any=1
fi

in_list() {  # <needle> <list-items...>
  local needle="$1" item; shift
  for item in "$@"; do [ "$item" = "$needle" ] && return 0; done
  return 1
}

# Legs. A leg is a script an adapter declares; it runs as a child under this script's own
# interpreter ("$BASH"), after the per-repo syncs (after-sync) or after the health leg (last). Its
# env: the SWEEP_* values, KIT_LIB and the sweep-opt values (empty when not given); the sweep
# token, GH_TOKEN and GIT_ASKPASS are never set for it. It prints its own result lines and exits 0
# once it has reached them, and records its own health result in an EXIT trap, so a non-zero exit
# means the leg itself broke: the runner then prints one line and, for the leg named `mirror`,
# records the failure so the digest shows it instead of the last green mark.
KIT_LIB="$(cd "$BIN/../.." && pwd)"

LEG_PID=""

# INT or TERM while a leg runs: the leg gets TERM (a background child of this shell ignores INT, and
# cannot trap it), this waits until the leg has gone, and the sweep ends with nothing after it.
leg_signal() {  # <exit code>
  local code="$1"
  trap '' INT TERM
  if [ -n "$LEG_PID" ]; then
    kill -TERM "$LEG_PID" 2>/dev/null
    wait "$LEG_PID" 2>/dev/null
  fi
  exit "$code"
}

leg_fallback_record() {  # <leg name> <rc> <text>
  [ "$1" = "mirror" ] || return 0
  printf '%s\n' "$3" | python3 "$HEALTH_BIN" record --leg mirror --rc "$2" --health-state-file "$HEALTH_STATE" 2>&1 | sed 's/^/    /'
}

run_leg() {  # <name> <script>
  local name="$1" script="$2" lrc
  if [ ! -f "$script" ]; then
    echo "  leg $name failed: $script not found"
    leg_fallback_record "$name" 1 "leg $name failed: $script not found"
    rc_any=1
    return
  fi
  trap 'leg_signal 130' INT
  trap 'leg_signal 143' TERM
  (
    export SWEEP_NAME="$NAME" SWEEP_BOARDS="$BOARDS" SWEEP_REPO_ROOT="$REPO_ROOT" SWEEP_DRY_RUN="$DRY_RUN" \
      SWEEP_BOARD_CMD="$BOARD_CMD" SWEEP_HEALTH_BIN="$HEALTH_BIN" SWEEP_HEALTH_STATE="$HEALTH_STATE" KIT_LIB="$KIT_LIB"
    i=0
    while [ "$i" -lt "${#SWEEPOPT_ENV[@]}" ]; do
      export "${SWEEPOPT_ENV[$i]}=${SWEEPOPT_VAL[$i]}"
      i=$((i + 1))
    done
    exec "$BASH" "$script"
  ) </dev/null &
  LEG_PID=$!
  wait "$LEG_PID"; lrc=$?
  LEG_PID=""
  trap - INT TERM
  if [ "$lrc" -ne 0 ]; then
    echo "  leg $name exited $lrc (non-fatal)"
    leg_fallback_record "$name" "$lrc" "leg $name exited $lrc"
  fi
}

run_legs() {  # <phase>
  local i=0
  while [ "$i" -lt "${#LEG_PHASE[@]}" ]; do
    [ "${LEG_PHASE[$i]}" = "$1" ] && run_leg "${LEG_NAME[$i]}" "${LEG_PATH[$i]}"
    i=$((i + 1))
  done
}

sync_one() {
  local path="$1" name="$2" root out rc spec
  local -a extra=() sync_flags=()
  [ -f "$path" ] || { echo "  skip $name (no board at $path)"; return; }
  root="${path%/_meta/BACKLOG.md}"; root="${root%/BACKLOG.md}"
  for spec in ${REPO_ARGS[@]+"${REPO_ARGS[@]}"}; do
    [ "${spec%%=*}" = "$name" ] && extra+=("${spec#*=}")
  done
  [ "$DRY_RUN" -eq 1 ] && sync_flags+=(--dry-run)
  # the token reaches ONLY the legs named by --sync-token-repo, never the
  # generic sync env (least privilege)
  if [ -n "$SWEEP_TOKEN" ] && in_list "$name" ${SYNC_TOKEN_REPOS[@]+"${SYNC_TOKEN_REPOS[@]}"}; then
    out="$(cd "$root" && GH_TOKEN="$SWEEP_TOKEN" "$BOARD_CMD" sync --backlog-file "$path" ${sync_flags[@]+"${sync_flags[@]}"} ${extra[@]+"${extra[@]}"} 2>&1 </dev/null)"; rc=$?
  else
    out="$(cd "$root" && "$BOARD_CMD" sync --backlog-file "$path" ${sync_flags[@]+"${sync_flags[@]}"} ${extra[@]+"${extra[@]}"} 2>&1 </dev/null)"; rc=$?
  fi
  if [ "$rc" -ne 0 ]; then
    # a repo with no [sync] block exits 2; that is a skip, not a failure
    case "$out" in
      *"no [sync] apps configured"*) echo "  skip $name (no [sync] block)"; return;;
    esac
    rc_any=1
  fi
  echo "  $name rc=$rc"
  printf '%s\n' "$out" | sed 's/^/    /'
  # the health leg reads these records; a record failure never fails the sweep
  printf '%s\n' "$out" | python3 "$HEALTH_BIN" record --repo "$name" --rc "$rc" --health-state-file "$HEALTH_STATE" 2>&1 | sed 's/^/    /'
  [ -n "$POSTER" ] && printf '%s\n' "$out" | bash "$DIGEST" --repo "$name" "${digest_common[@]}" 2>&1 | sed 's/^/    /'
  # publish leg (`board publish`): ONLY when this sync itself wrote the board (a
  # ✓/~/+ board action line). The gate keeps a no-write run from publishing,
  # but when the sync DID write, any human edits already sitting in the same
  # file ride the commit; board edits belong in git either way. rc 3 =
  # committed-but-not-on-remote; any nonzero publish rc flips rc_any so the
  # withheld on-clean hook surfaces it instead of rotting silently.
  if printf '%s\n' "$out" | grep -q -e '~ board ' -e '+ board ' -e '✓ board '; then
    local pout prc
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "    board publish: skipped (dry-run)"
      return
    fi
    if [ -n "$SWEEP_TOKEN" ]; then
      pout="$(GIT_ASKPASS="$GIT_ASKPASS_HELPER" BOARD_SYNC_GIT_TOKEN="$SWEEP_TOKEN" GIT_TERMINAL_PROMPT=0 \
        "$BOARD_CMD" publish --backlog-file "$path" 2>&1)"; prc=$?
    else
      pout="$("$BOARD_CMD" publish --backlog-file "$path" 2>&1)"; prc=$?
    fi
    printf '%s\n' "$pout" | sed 's/^/    /'
    [ "$prc" -ne 0 ] && rc_any=1
  fi
}

# fd 3, not stdin: the sync engine reads stdin and would eat the rest of the
# registry, silently syncing only the first few repos
while read -r name path _rest <&3; do
  case "$name" in ''|\#*) continue;; esac
  sync_one "${path/#\~/$HOME}" "$name"
done 3< "$BOARDS"

for extra_board in ${EXTRA_BOARDS[@]+"${EXTRA_BOARDS[@]}"}; do
  sync_one "$extra_board" "$(basename "$(dirname "$(dirname "$extra_board")")")"
done

run_legs after-sync

if [ -n "$POSTER" ]; then
  post_flags=()
  [ "$DRY_RUN" -eq 1 ] && post_flags+=(--dry-run)
  while IFS= read -r cluster; do
    [ -n "$cluster" ] || continue
    bash "$POST" --cluster "$cluster" --poster "$POSTER" "${digest_common[@]}" ${post_flags[@]+"${post_flags[@]}"} 2>&1 | sed 's/^/  /'
  done < <(bash "$DIGEST" --list-clusters "${digest_common[@]}")
fi

# health leg: observational like the digest, never flips the exit code
if [ "$HEALTH" -eq 1 ]; then
  hflags=(--registry "$BOARDS" --state-file "$STATE_FILE" --health-state-file "$HEALTH_STATE")
  [ -n "$HEALTH_MAP" ] && hflags+=(--cluster-map "$HEALTH_MAP")
  [ -n "$POSTER" ] && hflags+=(--poster "$POSTER")
  [ "$DRY_RUN" -eq 1 ] && hflags+=(--dry-run)
  python3 "$HEALTH_BIN" run "${hflags[@]}" ${health_flags[@]+"${health_flags[@]}"} 2>&1 | sed 's/^/  /'
fi

run_legs last

if [ "$rc_any" -eq 0 ] && [ "$DRY_RUN" -eq 0 ] && [ -n "$ON_CLEAN" ]; then
  "$ON_CLEAN" || echo "  on-clean hook failed (non-fatal)"
fi
[ -n "${DRY_STATE:-}" ] && rm -f "$DRY_STATE"
[ -n "${DRY_HEALTH_STATE:-}" ] && rm -f "$DRY_HEALTH_STATE"
echo "[$(ts)] $NAME: end rc=$rc_any"
exit "$rc_any"
