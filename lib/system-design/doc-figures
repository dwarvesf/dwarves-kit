#!/bin/bash
# Render the README and guide figures from docs/figures/MODEL.md, and check they are fresh.
# Usage: doc-figures render [--format png|svg] [--fz N] [--style FILE] [model] [outdir]   needs node 22+ and Chrome or Edge (CHROME overrides the path)
#        doc-figures check  [model] [outdir]   no browser; exit 1 on any problem
# Defaults: model docs/figures/MODEL.md, outdir docs/figures, both under the repo root. DOC_FIGURES_ROOT overrides the root.
# --format svg writes theme-aware <id>.svg (light and dark, fonts embedded); DOC_FIGURES_FORMAT sets the default (png).
# --fz N draws each figure at N times its natural size, so 10.5 px labels read at 10.5*N (1.3 gives about 13.5);
# a model's front matter `fz:` sets it too, the flag wins. --style FILE passes a style fragment to build.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
root=${DOC_FIGURES_ROOT:-$(cd "$here/../.." && pwd)}
die() { echo "doc-figures: $*" >&2; exit 1; }

hash_text() { if command -v shasum >/dev/null 2>&1; then shasum -a 256; else sha256sum; fi | cut -d' ' -f1; }

# blocks <model>: one "<id><TAB><sha256 of the block text>" line per uml fence, sorted by id.
# The block text is every line between the fences, each ended by a newline.
blocks() {
  local fence='```' inb=0 text='' id='' line trimmed
  while IFS= read -r line || [ -n "$line" ]; do
    trimmed=${line%"${line##*[![:space:]]}"}
    if [ "$inb" -eq 0 ]; then
      if [ "$trimmed" = "${fence}uml" ]; then inb=1; text=''; id=''; fi
    elif [ "$trimmed" = "$fence" ]; then
      inb=0
      [ -n "$id" ] || return 1
      printf '%s\t%s\n' "$id" "$(printf '%s' "$text" | hash_text)"
    else
      text+="$line"$'\n'
      if [ -z "$id" ] && [[ $line =~ ^id:[[:space:]]*(.*[^[:space:]]) ]]; then id=${BASH_REMATCH[1]}; fi
    fi
  done <"$1" | LC_ALL=C sort
}

# fm_fz <model>: the fz value from the model's leading --- front matter, or nothing.
fm_fz() {
  awk 'NR == 1 { if ($0 !~ /^---[ \t]*$/) exit; next } /^---[ \t]*$/ { exit }
    /^fz:/ { sub(/^fz:[ \t]*/, ""); sub(/[ \t]+(#.*)?$/, ""); print; exit }' "$1"
}

resolve_args() {
  model=${1:-$root/docs/figures/MODEL.md}
  outdir=${2:-$root/docs/figures}
  [ -f "$model" ] || die "no such model file: $model"
}

cmd_render() {
  local format=${DOC_FIGURES_FORMAT:-png} fz='' style=''
  while [ $# -gt 0 ]; do
    case "$1" in
      --format) format=${2:-}; shift 2 ;;
      --fz) fz=${2:-}; shift 2 ;;
      --style) style=${2:-}; shift 2 ;;
      --) shift; break ;;
      -*) die "unknown render flag: $1" ;;
      *) break ;;
    esac
  done
  case "$format" in png|svg) ;; *) die "--format must be png or svg, not: $format" ;; esac
  [ -z "$style" ] || [ -f "$style" ] || die "no such style file: $style"
  resolve_args "$@"
  [ -n "$fz" ] || fz=$(fm_fz "$model")
  if [ -n "$fz" ]; then
    [[ $fz =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v z="$fz" 'BEGIN { exit !(z >= 0.5 && z <= 3) }' || die "fz must be a number from 0.5 to 3, not: $fz"
  fi
  local table; table=$(blocks "$model") || die "$model has a uml block without an id"
  [ -n "$table" ] || die "no uml blocks in $model"
  local dups; dups=$(printf '%s\n' "$table" | cut -f1 | uniq -d)
  [ -z "$dups" ] || die "duplicate sheet id: $dups"

  tmp=$(mktemp -d "${TMPDIR:-/tmp}/doc-figures.XXXXXX")
  trap 'rm -rf "$tmp"' EXIT
  # fz scales the laid-out figure as a whole (SHOT_ZOOM), not the template's --fz font variable: that one grows
  # glyphs inside fixed-pixel boxes and line pitches, so notes overflow their boxes and lines overlap.
  local frag=()
  [ -z "$style" ] || frag=(--style "$style")
  # The shots land in a scratch directory, so a stray (a cover, a sheet the model dropped) never reaches outdir.
  SHOT_CLIP=figure SHOT_FORMAT=$format SHOT_ZOOM=${fz:-1} SHOT_SCALE=${SHOT_SCALE:-2} bash "$here/build" --model "$model" ${frag[@]+"${frag[@]}"} --out "$tmp/figures.html" --shots "$tmp/shots" >"$tmp/build.log" 2>&1 \
    || { cat "$tmp/build.log" >&2; die "build or shots failed"; }

  mkdir -p "$outdir"
  local id
  while IFS=$'\t' read -r id _; do
    [ -f "$tmp/shots/d-$id.$format" ] || die "no shot for sheet $id"
    mv -f "$tmp/shots/d-$id.$format" "$outdir/$id.$format"
  done <<<"$table"
  # A 16-hex digest detects a stale sheet and stays clear of secret scanners that block 64-hex strings.
  printf '%s\n' "$table" | awk -F'\t' -v OFS='\t' '{ print $1, substr($2, 1, 16) }' >|"$outdir/MANIFEST.tsv"
  grep -h '^svg ' "$tmp/build.log" || true
  echo "rendered $(printf '%s\n' "$table" | wc -l | tr -d ' ') $format figures into $outdir${fz:+ (fz $fz)}"
}

rendered_svg() { [ -f "$1" ] && grep -q 'data-doc-figures=' "$1"; }

cmd_check() {
  resolve_args "$@"
  local bad=0
  problem() { echo "$1"; bad=1; }
  local manifest=$outdir/MANIFEST.tsv
  [ -f "$manifest" ] || { echo "MANIFEST.tsv: missing in $outdir (run render)"; exit 1; }

  local table; table=$(blocks "$model") || { echo "$model: a uml block has no id"; exit 1; }
  local model_ids; model_ids=$(printf '%s\n' "$table" | cut -f1)
  local manifest_ids; manifest_ids=$(cut -f1 "$manifest")
  local dups; dups=$(printf '%s\n' "$model_ids" | uniq -d)
  [ -z "$dups" ] || problem "$model: duplicate sheet id: $dups"

  local id hash mhash
  # Model against manifest, both ways.
  while IFS=$'\t' read -r id hash; do
    [ -n "$id" ] || continue
    mhash=$(awk -F'\t' -v id="$id" '$1 == id { print $2; exit }' "$manifest")
    # render writes a 16-hex digest; a manifest from before that holds the full 64. Compare at the stored length.
    if [ -z "$mhash" ]; then problem "$id: in the model, not in MANIFEST.tsv (run render)"
    elif { [ "${#mhash}" -ne 16 ] && [ "${#mhash}" -ne 64 ]; } || [ "${hash:0:${#mhash}}" != "$mhash" ]; then
      problem "$id: sheet changed since the last render (run render)"; fi
  done <<<"$table"
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    printf '%s\n' "$model_ids" | grep -qxF -- "$id" || problem "$id: in MANIFEST.tsv, not in the model"
    # A figure is <id>.png, or <id>.svg from render --format svg (it carries the marker; a hand-drawn SVG does not).
    if [ -f "$outdir/$id.png" ] && rendered_svg "$outdir/$id.svg"; then problem "$id: both $id.png and $id.svg are rendered; remove the stale one"
    elif [ ! -f "$outdir/$id.png" ] && ! rendered_svg "$outdir/$id.svg"; then problem "$id: $outdir/$id.png is missing"; fi
  done <<<"$manifest_ids"
  # A PNG or a rendered SVG the manifest does not list.
  local f
  for f in "$outdir"/*.png "$outdir"/*.svg; do
    [ -e "$f" ] || continue
    case $f in *.svg) rendered_svg "$f" || continue ;; esac
    id=$(basename "$f"); id=${id%.*}
    printf '%s\n' "$manifest_ids" | grep -qxF -- "$id" || problem "$id: $f is not in MANIFEST.tsv"
  done

  # Every figures/<id>.png reference in README.md and the living docs names a manifest id.
  # Dated records (proofs, specs, notes, retros, research) describe their moment and may quote a bad id on purpose.
  local docs=() file line ref
  [ ! -f "$root/README.md" ] || docs+=("$root/README.md")
  while IFS= read -r file; do docs+=("$file"); done < <(find "$root/docs" \( -path "$root/docs/verification" -o -path "$root/docs/specs" \
    -o -path "$root/docs/implementation-notes" -o -path "$root/docs/retro" -o -path "$root/docs/research" \
    -o -path "$root/docs/audits" \) -prune -o -name '*.md' -type f -print 2>/dev/null | LC_ALL=C sort)
  for file in ${docs[@]+"${docs[@]}"}; do
    while IFS=: read -r line ref; do
      [ -n "$ref" ] || continue
      id=${ref#figures/}; id=${id%.png}
      printf '%s\n' "$manifest_ids" | grep -qxF -- "$id" || problem "${file#"$root"/}:$line: figures/$id.png names no manifest id"
    done < <(grep -noE 'figures/[A-Za-z0-9_-]+\.png' "$file" || true)
  done
  [ "$bad" -eq 0 ] || exit 1
  echo "doc-figures: ok ($(printf '%s\n' "$manifest_ids" | wc -l | tr -d ' ') figures)"
}

case "${1:-}" in
  render) shift; cmd_render "$@" ;;
  check) shift; cmd_check "$@" ;;
  -h|--help) sed -n 2,7p "$0" ;;
  '') sed -n 2,7p "$0" >&2; exit 2 ;;
  *) die "unknown verb: $1 (use render or check)" ;;
esac
