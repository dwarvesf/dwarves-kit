#!/usr/bin/env python3
"""add-backlog: review + flush backlog-stage's staged candidates onto the board.

Operator entry is `board promote` (bin/board -> lib/board/board.sh promote -> this
file) since ADR-0034 decision 7 retired the standalone `add-backlog` bin entry, no
alias. This engine file keeps its name (a deep lib path, not an operator surface).

The human gate (kit-foldin port of ops-toolkit cc-backlog's reviewer; recovered
2026-07-11 when the retired snapshot copy was the last one alive). backlog-stage
auto-stages candidates to `_meta/backlog-staging.md`;
this promotes the chosen ones into `_meta/BACKLOG.md` with the next free ID-NNN,
carrying the work-intake fields. Promoted candidates are marked in the staging file.

Usage:
  board promote                 list staged candidates (numbered)
  board promote <n> [<n>...]    promote those candidates onto the board
  board promote all             promote every staged candidate
  board promote reject <n>...   mark candidates rejected (not promoted)

Three refusals guard the board at promote time (a candidate is never deleted, it stays
`[staged]` for the operator to fix or reject):

  - judgment-free : Intent is nothing but the block's own source URL.
  - stale         : the block was staged more than BOARD_PROMOTE_MAX_AGE_DAYS ago, so it may
                    already be done. ID-294 measured 19 of 69 candidates finished inside a
                    16-day triage gap, which is why the default window is 14 days and not
                    `reflect drain`'s looser 30. Override with BOARD_PROMOTE_STALE_OK=1 once
                    the work is confirmed still open.
  - mis-homed     : the block names a Home, cites a file path, and that path lives in THIS
                    repo instead of the named one.

Env: BACKLOG_STAGE_BACKLOG, BACKLOG_STAGE_STAGING (same names + repo-relative
defaults as hooks/backlog-stage.sh: `git rev-parse --show-toplevel` else $PWD),
BACKLOG_PROMOTE_HOMES (directory the Home names resolve under; default: this repo's parent).
Promoted rows land in a `### Conversation intake` section (created if missing);
re-file into the right section by hand later.

Writers. Rows are minted by the one row verb (lib/board/board_add.py, `backlog.sh add`), in
the target table's own column count. The staging buffer is rewritten only through
staging-format.py `rewrite` under the staging lock, re-reading the file INSIDE the hold, so a
block a proposer appended while a promote ran is kept. Lock order: board lock, then staging
lock. A block that changed since it was listed (expired by drain, promoted by a second
session) is skipped with a note, never minted twice. Stdlib plus sync_core.
"""
import datetime
import importlib.util
import os
import re
import subprocess
import sys


def _repo_root():
    try:
        r = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return os.getcwd()


_ROOT = _repo_root()
BACKLOG = os.environ.get("BACKLOG_STAGE_BACKLOG", os.path.join(_ROOT, "_meta/BACKLOG.md"))
STAGING = os.environ.get("BACKLOG_STAGE_STAGING", os.path.join(_ROOT, "_meta/backlog-staging.md"))
SECTION = "### Conversation intake"


def _load(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    sys.modules[name] = mod
    spec.loader.exec_module(mod)
    return mod


_LIB = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
# The one staging grammar and the one staging lock (lib/reflect/staging-format.py).
sf = _load("staging_format", os.path.join(_LIB, "reflect", "staging-format.py"))
parse_staging = sf.parse_blocks


sys.path.insert(0, os.path.join(_LIB, "sync"))
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from sync_core import board_lock  # noqa: E402
import board_add  # noqa: E402


def clean(s):
    return s.replace("|", "/").strip()


def _norm_url(s):
    """Collapse whitespace and drop one trailing slash, so two renderings of
    the same URL compare equal."""
    return re.sub(r"\s+", " ", s.strip()).rstrip("/")


def judgment_free(b):
    """True when a block's Intent is nothing but its own source URL: the
    auto-sweep pipeline (intake-sweep) puts the raw link in Approach for
    URL-shaped candidates, so no human reasoning ever went into Intent.
    Checks Source too for well-formed blocks that put the URL there."""
    intent = _norm_url(b["fields"].get("Intent", ""))
    if not intent.startswith(("http://", "https://")):
        return False
    return intent in (
        _norm_url(b["fields"].get("Source", "")),
        _norm_url(b["fields"].get("Approach", "")),
    )


MAX_AGE_DAYS = int(os.environ.get("BOARD_PROMOTE_MAX_AGE_DAYS") or 14)
_SOURCE_DATE_RE = re.compile(r"(\d{4}-\d{2}-\d{2})")
# A repo-relative file path with an extension: `tools/repo-sweep/whathas.py`, `lib/x.sh`.
_CITED_PATH_RE = re.compile(r"(?<![\w/.])((?:[\w.-]+/)+[\w.-]+\.[A-Za-z0-9]+)")


def stale_days(b):
    """Whole days since the block's Source date, or None when it carries no parseable one.
    Age unknown is never treated as stale (the same rule `reflect drain` expiry follows)."""
    m = _SOURCE_DATE_RE.search(b["fields"].get("Source", ""))
    if not m:
        return None
    try:
        staged = datetime.date.fromisoformat(m.group(1))
    except ValueError:
        return None
    return (datetime.date.today() - staged).days


def home_dir(home):
    """Resolve a Home name to a checkout directory, or None when it names nothing we see.
    Looks under BACKLOG_PROMOTE_HOMES (default: this repo's parent, the workspace layout)."""
    home = home.strip().strip("`")
    if not home or "/" in home or " " in home:
        return None
    root = os.path.realpath(_ROOT)
    if os.path.basename(root) == home:
        return root
    base = os.environ.get("BACKLOG_PROMOTE_HOMES") or os.path.dirname(root)
    cand = os.path.join(base, home)
    return cand if os.path.exists(os.path.join(cand, ".git")) else None


def mis_homed(b):
    """The cited path that proves the block is filed against the wrong repo, else None.

    Both halves are required: the path must be ABSENT from the named home AND PRESENT in
    this repo. Absence alone is not evidence, because a proposal may name a file that does
    not exist yet; presence here is what makes the wrong home decisive (ID-294 candidate 35
    targeted a dotfiles hook that only ever lived in the kit). An unresolvable home is
    unknown, not wrong, and never refuses.
    """
    hd = home_dir(b["fields"].get("Home", ""))
    if not hd or os.path.realpath(hd) == os.path.realpath(_ROOT):
        return None
    for field in ("Intent", "Approach", "Source"):
        for m in _CITED_PATH_RE.finditer(b["fields"].get(field, "")):
            path = m.group(1)
            if os.path.exists(os.path.join(_ROOT, path)) and not os.path.exists(
                    os.path.join(hd, path)):
                return path
    return None


def refusal(b):
    """The one-line reason this block must not reach the board, or None to promote it."""
    if judgment_free(b):
        return ("Intent is nothing but the source URL, no judgment was exercised; route it "
                "through the digest / work-intake intake door instead of board promote.")
    age = stale_days(b)
    if age is not None and age > MAX_AGE_DAYS and not os.environ.get("BOARD_PROMOTE_STALE_OK"):
        return (f"staged {age}d ago (>{MAX_AGE_DAYS}d), so it may already be done; confirm "
                "the work is still open, then re-run with BOARD_PROMOTE_STALE_OK=1.")
    path = mis_homed(b)
    if path:
        home = b["fields"].get("Home", "").strip()
        return (f"Home says {home}, but the cited {path} lives in this repo and not there; "
                "fix the Home before promoting.")
    return None


def row_spec(b):
    """The `board_add` spec for one staged block: the title, plus the Intent / Approach /
    Tags / Home / Source composed into the first middle cell (Notes & source)."""
    f = b["fields"]
    notes = (
        f"Intent: {clean(f.get('Intent', ''))} . "
        f"Approach: {clean(f.get('Approach', ''))} "
        f"{clean(f.get('Tags', ''))}"
    )
    home = clean(f.get("Home", ""))
    src = clean(f.get("Source", ""))
    if home:
        notes += f" -> {home}"
    if src:
        notes += f" ({src})"
    return {"title": clean(b["title"]), "mids": [notes], "status": "queued"}


def _retag(text, block, new_head):
    """`text` with `block`'s `## [staged]` heading replaced by `new_head`, or None when the
    block is no longer in `text` verbatim (it changed after it was listed)."""
    raw = block["raw"]
    if raw not in text:
        return None
    return text.replace(raw, raw.replace("## [staged]", new_head, 1), 1)


def promote_blocks(chosen):
    """Mint a board row for each chosen block and relabel it `[promoted ID-N]`; returns
    (promoted [(id, title)], skipped [block]).

    The single writer for both files. The board lock (sync_core.board_lock: stable inode OUTSIDE
    the repo) serializes the id mint against every other minter (parallel promotes minting the
    same id is how duplicates got in, kit ID-288); the staging lock serializes the relabel
    against proposers appending and drain expiring. Order: board, then staging. The slow git
    history scan runs BEFORE the staging lock is taken, so a hook appending is never stuck behind
    a fetch. Staging is re-read inside the hold; a block that no longer matches (expired,
    promoted by another session) is skipped, and rows are minted only for blocks the relabel is
    known to reach, so the board and the buffer cannot disagree within one run."""
    promoted, skipped = [], []
    with board_lock(BACKLOG):
        floor = board_add.history_floor(BACKLOG)

        def _promote(current):
            plan, probe = [], current
            for b in chosen:
                nxt = _retag(probe, b, "## [promoted]")
                if nxt is None:
                    skipped.append(b)
                else:
                    probe = nxt
                    plan.append(b)
            if not plan:
                return current, None
            ids = board_add.add_rows_locked(BACKLOG, [row_spec(b) for b in plan],
                                            section=SECTION, floor=floor)
            for b, cid in zip(plan, ids):
                current = _retag(current, b, f"## [promoted {cid}]")
                promoted.append((cid, b["title"]))
            return current, None

        sf.rewrite(STAGING, _promote)
    return promoted, skipped


def main(argv):
    global BACKLOG, STAGING
    # Consumer shims (`<repo>/_meta/board`) append `--backlog-file <path>` to
    # every subcommand; honour it here so `promote <n>` through a shim resolves
    # the same board the shim named, with the staging file beside it. Env
    # overrides still win (tests pin them).
    argv = list(argv)
    if "--backlog-file" in argv:
        i = argv.index("--backlog-file")
        if i + 1 >= len(argv):
            print("usage: board promote [list | <n>... | all | reject <n>...] [--backlog-file <path>]", file=sys.stderr)
            return 2
        path = os.path.abspath(argv[i + 1])
        del argv[i:i + 2]
        if "BACKLOG_STAGE_BACKLOG" not in os.environ:
            BACKLOG = path
        if "BACKLOG_STAGE_STAGING" not in os.environ:
            STAGING = os.path.join(os.path.dirname(path), "backlog-staging.md")
    if not os.path.isfile(STAGING):
        print(f"no staging file ({STAGING}); nothing staged.")
        return 0
    text = open(STAGING, encoding="utf-8").read()
    blocks = parse_staging(text)
    staged = [b for b in blocks if b["state"] == "staged"]

    if not argv or argv[0] == "list":
        if not staged:
            print("no staged candidates.")
            return 0
        for n, b in enumerate(staged, 1):
            print(f"{n}. {b['title']}  [{b['fields'].get('Tags', '')}]")
        print(f"\npromote with: board promote <n>...  |  board promote all  |  board promote reject <n>")
        return 0

    # This engine takes no flags -- it resolves its targets from
    # BACKLOG_STAGE_BACKLOG / BACKLOG_STAGE_STAGING. Say so plainly instead of
    # feeding an unrecognised flag to int() below and reporting it as a usage
    # error about the SELECTION, which is what made #443 hard to read: consumer
    # shims append --backlog-file, and every `promote <n>` failed with a message
    # about candidate numbers. board.sh translates the flag before we are
    # reached; anything still flag-shaped here is genuinely unhandled.
    flags = [a for a in argv if a.startswith("-")]
    if flags:
        print(f"add-backlog: unrecognised option(s): {' '.join(flags)}", file=sys.stderr)
        print("  this engine takes no flags; set BACKLOG_STAGE_BACKLOG / "
              "BACKLOG_STAGE_STAGING instead.", file=sys.stderr)
        print("  (invoked via `board promote`? board.sh translates "
              "--backlog-file for you -- reaching here means it did not.)", file=sys.stderr)
        return 2

    reject = argv[0] == "reject"
    sel = argv[1:] if reject else argv
    if (not reject) and argv[0] == "all":
        picks = list(range(1, len(staged) + 1))
    else:
        try:
            picks = sorted(set(int(x) for x in sel))
        except ValueError:
            print("usage: board promote [list | <n>... | all | reject <n>...]", file=sys.stderr)
            return 2
    chosen = [staged[p - 1] for p in picks if 1 <= p <= len(staged)]
    if not chosen:
        print("no matching staged candidates.")
        return 1

    if reject:
        def _reject(current):
            n = 0
            for b in chosen:
                new = _retag(current, b, "## [rejected]")
                if new is None:
                    print(f"skipped {b['title']!r}: changed since it was listed", file=sys.stderr)
                    continue
                current, n = new, n + 1
            return current, n
        n = sf.rewrite(STAGING, _reject)
        print(f"rejected {n} candidate(s).")
        return 0 if n else 1

    refused_ids = set()
    for b in chosen:
        why = refusal(b)
        if why:
            refused_ids.add(id(b))
            print(f"refused {b['title']!r}: {why}", file=sys.stderr)
    chosen = [b for b in chosen if id(b) not in refused_ids]
    if not chosen:
        return 1

    if not os.path.isfile(BACKLOG):
        print(f"board not found: {BACKLOG}", file=sys.stderr)
        return 2
    promoted, skipped = promote_blocks(chosen)
    for b in skipped:
        print(f"skipped {b['title']!r}: changed since it was listed (re-run `board promote`)",
              file=sys.stderr)
    for cid, title in promoted:
        print(f"promoted {cid}: {title}")
    return 0 if promoted else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
