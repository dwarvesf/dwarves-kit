#!/usr/bin/env bash
# skill-review: the human-run promote gate CLI (the /skill-review skill calls this). BTM-friendly
# (no .sh). This is the ONLY writer of ~/.claude/skills/; the background reviewer never writes there.
#   skill-review list                  list staged drafts (slug + description)
#   skill-review promote <slug> [--force]   move a draft into ~/.claude/skills/ (refuses overwrite + secret)
#   skill-review reject <slug>         move a draft into _rejected/ (never deletes)
#   skill-review auto                  promote only the auto-eligible drafts (if auto_promote=on)
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/promote.sh
. "$HERE/../lib/promote.sh"

case "${1:-list}" in
  list)    promote_list ;;
  promote) promote_one "${2:-}" "${3:-}" ;;
  reject)  promote_reject "${2:-}" ;;
  auto)    promote_auto ;;
  *) echo "usage: skill-review {list|promote <slug> [--force]|reject <slug>|auto}" >&2; exit 2 ;;
esac
