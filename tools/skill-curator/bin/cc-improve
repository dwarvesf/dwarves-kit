#!/usr/bin/env bash
# cc-improve: cc-self-improve CLI. BTM-friendly (this file is ProgramArguments[0], no .sh).
#   cc-improve status      show staged drafts + 7-day loop spend from the ledger
#   cc-improve curate      (Phase C, sub-goal 04) consolidate the skill library, propose-only
#   cc-improve restore     (Phase C, sub-goal 04) restore an archived skill
# Phase A ships `status`; curate/restore arrive with the curator.

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
. "$HERE/../lib/common.sh"

cmd_status() {
  echo "cc-self-improve status"
  echo "  state dir:     $CC_SI_STATE_DIR"
  echo "  proposals dir: $CC_SI_PROPOSALS_DIR"

  local drafts=0
  if [ -d "$CC_SI_PROPOSALS_DIR" ]; then
    drafts="$(find "$CC_SI_PROPOSALS_DIR" -mindepth 2 -maxdepth 2 -name SKILL.md 2>/dev/null | wc -l | tr -d ' ')"
  fi
  echo "  staged skill drafts: $drafts"

  if [ -f "$CC_SI_LEDGER" ]; then
    # 7-day window without GNU date: compare ISO timestamps lexically to a cutoff string.
    local cutoff; cutoff="$(date -v-7d '+%Y-%m-%d' 2>/dev/null || date -d '7 days ago' '+%Y-%m-%d' 2>/dev/null || echo '0000-00-00')"
    jq -rs --arg cut "$cutoff" '
      [ .[] | select((.ts // "") >= $cut) ] as $w
      | "  reviewer runs (7d): \($w | length)"
      + "   staged: \([ $w[] | select(.staged==true) ] | length)"
      + "\n  loop spend (7d): $\(( [ $w[].total_cost_usd // 0 ] | add ) // 0 )"
    ' "$CC_SI_LEDGER" 2>/dev/null || echo "  ledger: (unreadable)"
  else
    echo "  ledger: (none yet)"
  fi
}

case "${1:-status}" in
  status) cmd_status ;;
  curate|restore)
    echo "cc-improve $1: not yet , arrives with the curator (cc-elevation-r4 sub-goal 04 / SPEC-103 Phase C)." >&2
    exit 2 ;;
  *) echo "usage: cc-improve {status|curate|restore}" >&2; exit 2 ;;
esac
