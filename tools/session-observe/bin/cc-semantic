#!/usr/bin/env python3
"""cc-semantic: LLM-derived semantic signals over recent Claude Code prompts.

Two signals a deterministic parser cannot produce, emitted as PROPOSALS ONLY
(this tool writes NOTHING durable , no ledger, no GLOSSARY, no board):
  topic-drift       - cluster my recent prompts into topic buckets (what I
                      actually spend Claude Code on, vs what I think I do)
  self-correction   - how often a prompt corrects a prior claim/answer (a rough
                      reliability-trend proxy)

A cheap model (Claude Haiku via `claude -p`, NOT mini.ollama) is fed a windowed,
capped sample of user-prompt texts and must return ONE JSON object:
  {"topics": [{"name": "...", "count": N}, ...], "self_corrections": N}

The model command is overridable via `CC_SEMANTIC_CMD` (the prompt is piped to its
stdin), so tests inject a fixed response and no live model is needed. If the
command is missing or fails, the tool degrades to `_unavailable_` , it never
fabricates. These are ESTIMATES (NLP, noisier than the deterministic cc-observe
views); the output is labelled as such and is for a human to act on.

Stdlib only. Read-only over the transcripts under ~/.claude/projects/.
"""
import json
import os
import shlex
import subprocess
import sys
import time
from collections import deque


def _repo_root():
    """Walk up from this file to find the kit repo root (the dir holding
    lib/session/). Repo-relative per DECISIONS.md's adapter-default invariant:
    no hardcoded ops-toolkit/personal path, no CONSUMER_ROOT env."""
    d = os.path.dirname(os.path.abspath(__file__))
    for _ in range(8):
        if os.path.isdir(os.path.join(d, "lib", "session")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    raise RuntimeError("cc-semantic: cannot locate the kit repo root (lib/session not found)")


sys.path.insert(0, os.path.join(_repo_root(), "lib", "session"))
from parse_transcript import iter_entries as _iter_transcript_entries  # noqa: E402

DEFAULT_ROOT = os.path.expanduser("~/.claude/projects")
DEFAULT_CMD = "claude -p"          # overridable via CC_SEMANTIC_CMD (tests inject)
MAX_PROMPTS = 200                  # cap the window fed to the model (cost bound)
MAX_PROMPT_CHARS = 300            # truncate each prompt (cost bound)


def collect_prompts(root, days, cap):
    """Newest-first user-prompt texts from non-sidechain transcripts, capped."""
    cutoff = time.time() - days * 86400 if days else None
    files = []
    for dirpath, _dirs, names in os.walk(root):
        for fn in names:
            if not fn.endswith(".jsonl"):
                continue
            p = os.path.join(dirpath, fn)
            try:
                mt = os.path.getmtime(p)
            except OSError:
                continue
            if cutoff is None or mt >= cutoff:
                files.append((mt, p))
    files.sort(reverse=True)  # newest files first
    out = deque(maxlen=cap)
    for _mt, p in files:
        try:
            entries = list(_iter_transcript_entries(p))  # force now: OSError on open must be catchable per-file
        except OSError:
            continue
        for e in entries:
            if e.get("type") != "user" or e.get("isSidechain"):
                continue
            c = (e.get("message") or {}).get("content")
            txt = c if isinstance(c, str) else " ".join(
                b.get("text", "") for b in (c if isinstance(c, list) else [])
                if isinstance(b, dict) and b.get("type") == "text")
            txt = txt.strip()
            if txt:
                out.append(txt[:MAX_PROMPT_CHARS])
        if len(out) >= cap:
            break
    return list(out)


def build_prompt(prompts):
    listing = "\n".join(f"- {p}" for p in prompts)
    return (
        f"Here are {len(prompts)} recent user prompts to a coding assistant.\n"
        "1. Cluster them into 3-7 topic buckets; give each a short name and a count.\n"
        "2. Count how many prompts correct or walk back a prior claim/answer.\n"
        'Return ONLY a JSON object, no prose:\n'
        '{"topics":[{"name":"...","count":N}],"self_corrections":N}\n\n'
        f"Prompts:\n{listing}\n"
    )


def parse_json(text):
    """Extract the first {...} JSON object and validate the expected keys."""
    i, j = text.find("{"), text.rfind("}")
    if i < 0 or j <= i:
        return None
    try:
        d = json.loads(text[i:j + 1])
    except json.JSONDecodeError:
        return None
    if not isinstance(d, dict) or "topics" not in d or "self_corrections" not in d:
        return None
    return d


def run_llm(prompt):
    cmd = os.environ.get("CC_SEMANTIC_CMD", DEFAULT_CMD)
    try:
        r = subprocess.run(shlex.split(cmd), input=prompt, capture_output=True, text=True, timeout=180)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    return parse_json(r.stdout)


def main(argv=None):
    import argparse
    p = argparse.ArgumentParser(prog="cc-semantic", description="LLM-derived semantic signals (propose-only) over recent prompts.")
    p.add_argument("--root", default=DEFAULT_ROOT)
    p.add_argument("--days", type=int, default=7)
    p.add_argument("--cap", type=int, default=MAX_PROMPTS)
    p.add_argument("--json", action="store_true")
    args = p.parse_args(argv)

    prompts = collect_prompts(args.root, args.days, args.cap)
    if not prompts:
        print("cc-semantic: no prompts in window (nothing to analyze)" if not args.json else json.dumps({"status": "empty"}))
        return 0

    result = run_llm(build_prompt(prompts))
    if result is None:
        print("cc-semantic: _unavailable_ (no LLM / command failed / unparseable output)"
              if not args.json else json.dumps({"status": "unavailable"}))
        return 0

    if args.json:
        print(json.dumps({"status": "ok", "prompts": len(prompts), **result}, indent=2))
        return 0

    print(f"# semantic  ({len(prompts)} prompts sampled; PROPOSAL ONLY , estimates, nothing written)")
    print("  topic drift:")
    for t in result.get("topics", []):
        print(f"    {t.get('count', '?'):>4}  {t.get('name', '?')}")
    print(f"  self-corrections: {result.get('self_corrections', '?')} of {len(prompts)} prompts")
    return 0


if __name__ == "__main__":
    sys.exit(main())
