#!/usr/bin/env bash
# Launcher for the cc-intel weekly digest. Kept as a top-level no-extension executable
# (not *.sh, not wrapped in /bin/bash) per the repo's BTM-friendly plist authoring rule,
# so Login Items & Extensions shows "cc-intel-weekly" with the exec icon.
set -euo pipefail

INTEL_DIR="$HOME/.claude/intel"

# 1) Write the weekly digest file (the primary, must-not-regress behavior).
"$HOME/.local/bin/cc-intel" run --out "$INTEL_DIR"

# 2) Ping the cc-intel-weekly heartbeat (cc-elevation-r3 SG-05). HEARTBEAT-ONLY
#    by design: NO --snapshot flag. The metrics-snapshot POST is intentionally
#    omitted because it registers a vps-mon `hosts` row subject to the hardcoded
#    600s agent-silent rule, which false-fires for this weekly pusher (incident
#    2026-06-15). The heartbeat (interval 604800 + grace 86400) is the correct
#    weekly liveness signal. Best-effort: a vps-mon outage or a missing op
#    session must NEVER fail the digest, so this whole block is non-fatal.
#    Secrets resolve from 1Password at runtime (op:// refs, never hardcoded).
bridge_to_vps_mon() {
  command -v op >/dev/null 2>&1 || { echo "cc-intel-weekly: op unavailable, skipping vps-mon bridge"; return 0; }
  command -v "$HOME/.local/bin/cc-vps-report" >/dev/null 2>&1 || { echo "cc-intel-weekly: cc-vps-report not on PATH, skipping bridge"; return 0; }
  # Heartbeat-only needs just the HB token (CC_VPS_HMAC_KEY is only read by the
  # opt-in --snapshot signer path, which this launcher does not use).
  CC_VPS_HB_TOKEN="$(op read 'op://Toolkit/cc-vps-report/hb_token' 2>/dev/null)" || return 0
  export CC_VPS_HB_TOKEN
  # Default (no --snapshot) = heartbeat-only.
  "$HOME/.local/bin/cc-vps-report"
}
bridge_to_vps_mon || echo "cc-intel-weekly: vps-mon bridge failed (non-fatal)"
