#!/usr/bin/env bash
# fake-mux -- a STUB terminal-mux for tests/test-queue.bats. Stands in for `tmux` via MUX_CMD so
# the suite drives queue.sh with NO real UI and NO real claude. It records the verbs it is asked
# to run (to $QLOG) and, on capture-pane, returns a canned transcript per window ($QSTUB/<slug>.
# transcript), or simulates a dead window when $QSTUB/<slug>.dead exists.
#
# Env:
#   QSTUB  dir holding <slug>.transcript (canned pane output) and optional <slug>.dead (window
#          exited -> capture-pane returns nonzero, the launcher's "window died" signal)
#   QLOG   append-only verb log the tests assert against (default $QSTUB/verbs.log)
set -u
QSTUB="${QSTUB:?fake-mux: QSTUB unset}"
QLOG="${QLOG:-$QSTUB/verbs.log}"

verb="${1:-}"; shift || true
args=("$@")

# Pull the window slug from `-t <sess>:<slug>` (tmux) or `-n <slug>` / `--window <slug>`.
slug=""
i=0
while [ "$i" -lt "${#args[@]}" ]; do
  case "${args[$i]}" in
    -t)          t="${args[$((i+1))]:-}"; slug="${t##*:}" ;;
    -n|--window) slug="${args[$((i+1))]:-}" ;;
  esac
  i=$((i+1))
done

case "$verb" in
  has-session) exit 1 ;;                                   # force the new-session path
  new-session) printf 'new-session\n'            >> "$QLOG"; exit 0 ;;
  new-window)  printf 'new-window slug=%s\n' "$slug" >> "$QLOG"; exit 0 ;;
  kill-window) printf 'kill-window slug=%s\n' "$slug" >> "$QLOG"; exit 0 ;;
  send-keys)
    last="${args[$(( ${#args[@]} - 1 ))]:-}"
    if [ "$last" = "Enter" ]; then
      printf 'enter slug=%s\n' "$slug" >> "$QLOG"
      # stuck-input simulation: each Enter decrements the pending counter; at 0 the input
      # clears (the submit finally took), mirroring the live dropped-Enter failure mode
      if [ -f "$QSTUB/$slug.pending" ]; then
        n="$(cat "$QSTUB/$slug.pending")"
        n=$((n - 1))
        if [ "$n" -le 0 ]; then rm -f "$QSTUB/$slug.pending"; else printf '%s' "$n" > "$QSTUB/$slug.pending"; fi
      fi
    else
      # the literal typed text is the last arg (after `-l --`); record it verbatim (NC5 proof)
      printf 'type slug=%s text=%s\n' "$slug" "$last" >> "$QLOG"
    fi
    exit 0 ;;
  capture-pane)
    [ -f "$QSTUB/$slug.dead" ] && exit 1
    if [ -f "$QSTUB/$slug.pending" ]; then
      # a long typed goal renders TAIL-first in the input box: no `/goal` substring anywhere
      printf '❯ (or "EXIT_SIGNAL: false" if you are not done), plus "REASON: <why>".\n'
      exit 0
    fi
    [ -f "$QSTUB/$slug.transcript" ] && cat "$QSTUB/$slug.transcript"
    exit 0 ;;
  *) exit 0 ;;
esac
